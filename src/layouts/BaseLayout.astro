---
import '../styles/global.css';
import '../styles/calculator.css';
import '../styles/landing.css';
import '../styles/fonts.css';
import '../styles/tokens.css'; // imported last: remaps legacy vars onto the light-default token system

interface Props {
  title: string;
  description: string;
  canonical: string;
  hreflang?: { lang: string; url: string }[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  lang?: 'de' | 'en';
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  theme?: 'home' | 'time-range' | 'work-hours' | 'countdown' | 'guide' | 'info';
  band?: string;       // Phase 5.2 accent band → data-band
  archetype?: string;  // Phase 5.1 layout archetype → data-archetype
  treatment?: string;  // Phase 5.3 result treatment → data-treatment
}

const {
  title,
  description,
  canonical,
  hreflang = [],
  noindex = false,
  jsonLd = [],
  lang = 'de',
  ogType = 'website',
  ogImage = 'https://zeit-rechner.com/og-image.png',
  ogImageAlt = lang === 'de' ? 'Zeit-Rechner.com — Präzise Online-Zeitrechner' : 'Zeit-Rechner.com — Precise Online Time Calculators',
  theme = 'home',
  band,
  archetype,
  treatment,
} = Astro.props;

const hubUrlDe = '/';
const hubUrlEn = '/en/';
const hubUrl = lang === 'de' ? hubUrlDe : hubUrlEn;
const altLang = lang === 'de' ? 'en' : 'de';
const altHubUrl = lang === 'de' ? hubUrlEn : hubUrlDe;

const navLinks = lang === 'de' ? [
  { href: '/', label: 'Rechner' },
  { href: '/alle-rechner/', label: 'Beliebte Zeiten' },
  { href: '/ratgeber/', label: 'Ratgeber' },
  { href: '/ueber-uns/', label: 'Über uns' },
] : [
  { href: '/en/', label: 'Calculator' },
  { href: '/en/all-calculators/', label: 'Popular Times' },
  { href: '/en/guides/', label: 'Guides' },
  { href: '/en/about-us/', label: 'About Us' },
];

const currentYear = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang={lang} dir="ltr" data-band={band} data-archetype={archetype} data-treatment={treatment}>
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-BMGKJ52S0M"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-BMGKJ52S0M');
  </script>
  <meta charset="UTF-8" />
  <meta name="google-site-verification" content="ghfewf_0IMFfKQGEg7-ClBv5fEuPeJjTxAHEKcc4_YY" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  {noindex && <meta name="robots" content="noindex, follow" />}
  {!noindex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />}

  <!-- hreflang -->
  {!noindex && hreflang.map(h => (
    <link rel="alternate" hreflang={h.lang} href={h.url} />
  ))}

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
  <meta property="og:site_name" content="Zeit-Rechner.com" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonical} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <!-- Theme: light default, dark derived. Set data-theme before paint to avoid FOUC. -->
  <meta name="theme-color" content="#F2F4F3" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0F1417" media="(prefers-color-scheme: dark)" />
  <meta name="color-scheme" content="light dark" />
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('zr-theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>

  <!-- JSON-LD -->
  {jsonLd.map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class={`theme-${theme}`}>
  {theme === 'guide' && <div class="reading-progress" id="reading-progress" aria-hidden="true" style="position: fixed; top: 64px; left: 0; height: 3px; background: var(--clr-accent); width: 0%; z-index: 101; transition: width 0.1s ease;"></div>}
  {theme === 'guide' && (
    <script is:inline>
      window.addEventListener('scroll', () => {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
        const progress = document.getElementById('reading-progress');
        if (progress) progress.style.width = scrolled + '%';
      });
    </script>
  )}

  <!-- ─── NAVBAR ──────────────────────────────────────────────────────────── -->
  <nav class="navbar" role="navigation" aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
    <div class="navbar__inner">
      <a href={hubUrl} class="navbar__logo" aria-label="Home">
        <svg class="navbar__logo-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--clr-accent); filter: drop-shadow(0 0 4px var(--clr-accent-glow));">
          <circle cx="12" cy="12" r="9" stroke="currentColor" />
          <polyline points="12 7 12 12 15 15" stroke="currentColor" />
          <path d="M12 2v2" stroke="currentColor" />
        </svg>
        <span>{lang === 'de' ? 'Zeit-Rechner' : 'Time Calculator'}</span>
      </a>

      <ul class="navbar__links" role="list">
        {navLinks.map(link => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>

      <div class="navbar__utils">
        <div class="theme-switch" role="group" aria-label={lang === 'de' ? 'Farbschema' : 'Color theme'}>
          <button type="button" class="theme-switch__btn" data-theme-set="light" aria-label={lang === 'de' ? 'Hell' : 'Light'} title={lang === 'de' ? 'Hell' : 'Light'}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          </button>
          <button type="button" class="theme-switch__btn" data-theme-set="system" aria-label="System" title="System">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          </button>
          <button type="button" class="theme-switch__btn" data-theme-set="dark" aria-label={lang === 'de' ? 'Dunkel' : 'Dark'} title={lang === 'de' ? 'Dunkel' : 'Dark'}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </button>
        </div>
        <div class="navbar__lang">
          <a href={hubUrlDe} class:list={['lang-btn', { active: lang === 'de' }]} hreflang="de" aria-label="Deutsch">DE</a>
          <a href={hubUrlEn} class:list={['lang-btn', { active: lang === 'en' }]} hreflang="en" aria-label="English">EN</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- ─── MAIN ────────────────────────────────────────────────────────────── -->
  <main id="main-content">
    <slot />
  </main>

  <!-- ─── FOOTER ──────────────────────────────────────────────────────────── -->
  <footer class="footer" role="contentinfo">
    <div class="footer__inner">
      <div class="footer__col">
        <h3>{lang === 'de' ? 'Rechner' : 'Calculators'}</h3>
        <ul>
          <li><a href={lang === 'de' ? '/' : '/en/'}>{lang === 'de' ? 'Zeitrechner' : 'Time Calculator'}</a></li>
          <li><a href={lang === 'de' ? '/stunden-zwischen-9-und-17/' : '/en/hours-between-9-and-17/'}>{lang === 'de' ? 'Stunden 9–17' : 'Hours 9–17'}</a></li>
          <li><a href={lang === 'de' ? '/stunden-zwischen-9-und-17/#arbeitszeit' : '/en/hours-between-9-and-17/#work-hours'}>{lang === 'de' ? 'Arbeitsstunden' : 'Work Hours'}</a></li>
          <li><a href={lang === 'de' ? '/tage-bis-weihnachten/' : '/en/days-until-christmas/'}>Countdown</a></li>
          <li><a href={lang === 'de' ? '/alle-rechner/' : '/en/all-calculators/'}>{lang === 'de' ? 'Alle Rechner (Sitemap)' : 'All Calculators (Sitemap)'}</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h3>{lang === 'de' ? 'Beliebt' : 'Popular'}</h3>
        <ul>
          <li><a href={lang === 'de' ? '/stunden-zwischen-8-und-17/' : '/en/hours-between-8-and-17/'}>{lang === 'de' ? '8–17 Uhr' : '8 AM – 5 PM'}</a></li>
          <li><a href={lang === 'de' ? '/stunden-zwischen-7-und-15/' : '/en/hours-between-7-and-15/'}>{lang === 'de' ? '7–15 Uhr' : '7 AM – 3 PM'}</a></li>
          <li><a href={lang === 'de' ? '/stunden-zwischen-10-und-18/' : '/en/hours-between-10-and-18/'}>{lang === 'de' ? '10–18 Uhr' : '10 AM – 6 PM'}</a></li>
          <li><a href={lang === 'de' ? '/stunden-zwischen-9-und-12/' : '/en/hours-between-9-and-12/'}>{lang === 'de' ? '9–12 Uhr' : '9 AM – 12 PM'}</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h3>{lang === 'de' ? 'Sprache' : 'Language'}</h3>
        <ul>
          <li><a href="/" hreflang="de">Deutsch</a></li>
          <li><a href="/en/" hreflang="en">English</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__legal">
      {lang === 'de' ? (
        <>
          <a href="/ueber-uns/">Über uns</a>
          <span class="footer__sep">•</span>
          <a href="/impressum/">Impressum</a>
          <span class="footer__sep">•</span>
          <a href="/datenschutz/">Datenschutz</a>
          <span class="footer__sep">•</span>
          <a href="/nutzungsbedingungen/">Nutzungsbedingungen</a>
          <span class="footer__sep">•</span>
          <a href="/sitemap.xml" target="_blank">XML Sitemap</a>
        </>
      ) : (
        <>
          <a href="/en/about-us/">About Us</a>
          <span class="footer__sep">•</span>
          <a href="/en/imprint/">Imprint</a>
          <span class="footer__sep">•</span>
          <a href="/en/privacy-policy/">Privacy Policy</a>
          <span class="footer__sep">•</span>
          <a href="/en/terms-of-service/">Terms of Service</a>
          <span class="footer__sep">•</span>
          <a href="/sitemap.xml" target="_blank">XML Sitemap</a>
        </>
      )}
    </div>
    <div class="footer__bottom">
      <span>{currentYear} Zeit-Rechner.com</span>
      <span>{lang === 'de' ? 'Kostenloser Online-Zeitrechner' : 'Free Online Time Calculator'}</span>
    </div>
  </footer>

  <!-- Screen-reader announcements (copy success, etc.) -->
  <div id="zr-live" aria-live="polite" class="visually-hidden"></div>

  <!-- ─── COPY-TO-CLIPBOARD ────────────────────────────────────────────────── -->
  <script is:inline>
    (function () {
      var live = document.getElementById('zr-live');
      var de = document.documentElement.lang === 'de';
      document.addEventListener('click', function (e) {
        var btn = e.target && e.target.closest ? e.target.closest('.copy-btn') : null;
        if (!btn) return;
        var val = btn.getAttribute('data-copy') || '';
        function done(ok) {
          btn.classList.remove('is-copied', 'is-error');
          btn.classList.add(ok ? 'is-copied' : 'is-error');
          if (live) live.textContent = (ok ? (de ? 'Kopiert: ' : 'Copied: ') : (de ? 'Kopieren fehlgeschlagen' : 'Copy failed')) + (ok ? val : '');
          setTimeout(function () { btn.classList.remove('is-copied', 'is-error'); }, 1500);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(val).then(function () { done(true); }, function () { done(false); });
        } else { done(false); }
      });
    })();
  </script>

  <!-- ─── THEME SWITCHER ───────────────────────────────────────────────────── -->
  <script is:inline>
    (function () {
      var root = document.documentElement;
      function current() {
        try { var t = localStorage.getItem('zr-theme'); return (t === 'light' || t === 'dark') ? t : 'system'; } catch (e) { return 'system'; }
      }
      function sync() {
        var mode = current();
        document.querySelectorAll('.theme-switch__btn').forEach(function (b) {
          b.setAttribute('aria-pressed', String(b.getAttribute('data-theme-set') === mode));
        });
      }
      document.querySelectorAll('.theme-switch__btn').forEach(function (b) {
        b.addEventListener('click', function () {
          var mode = b.getAttribute('data-theme-set');
          try {
            if (mode === 'system') { localStorage.removeItem('zr-theme'); root.removeAttribute('data-theme'); }
            else { localStorage.setItem('zr-theme', mode); root.setAttribute('data-theme', mode); }
          } catch (e) {}
          sync();
        });
      });
      sync();
    })();
  </script>

  <!-- ─── FAQ ACCORDION SCRIPT ─────────────────────────────────────────────── -->
  <script>
    document.querySelectorAll('.faq-item__question').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        const answer = btn.nextElementSibling as HTMLElement;
        if (answer) {
          answer.classList.toggle('open', !expanded);
          answer.setAttribute('aria-hidden', String(expanded));
        }
      });
    });
  </script>

</body>
</html>
