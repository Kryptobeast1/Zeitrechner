---
import '../styles/global.css';
import '../styles/calculator.css';
import '../styles/landing.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  hreflang?: { lang: string; url: string }[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  lang?: 'de' | 'en';
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  canonical,
  hreflang = [],
  noindex = false,
  jsonLd = [],
  lang = 'de',
  ogType = 'website',
  ogImage = 'https://zeit-rechner.com/og-image.png',
  ogImageAlt = lang === 'de' ? 'Zeit-Rechner.com — Präzise Online-Zeitrechner' : 'Zeit-Rechner.com — Precise Online Time Calculators',
} = Astro.props;

const hubUrlDe = '/';
const hubUrlEn = '/en/';
const hubUrl = lang === 'de' ? hubUrlDe : hubUrlEn;
const altLang = lang === 'de' ? 'en' : 'de';
const altHubUrl = lang === 'de' ? hubUrlEn : hubUrlDe;

const navLinks = lang === 'de' ? [
  { href: '/', label: 'Zeitrechner' },
  { href: '/#differenz', label: 'Differenz' },
  { href: '/#arbeitsstunden', label: 'Arbeitsstunden' },
  { href: '/#countdown', label: 'Countdown' },
  { href: '/ueber-uns/', label: 'Über uns' },
] : [
  { href: '/en/', label: 'Calculator' },
  { href: '/en/#diff', label: 'Difference' },
  { href: '/en/#work', label: 'Work Hours' },
  { href: '/en/#countdown', label: 'Countdown' },
  { href: '/en/about-us/', label: 'About Us' },
];

const currentYear = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang={lang} dir="ltr">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-BMGKJ52S0M"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-BMGKJ52S0M');
  </script>
  <meta charset="UTF-8" />
  <meta name="google-site-verification" content="ghfewf_0IMFfKQGEg7-ClBv5fEuPeJjTxAHEKcc4_YY" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  {noindex && <meta name="robots" content="noindex, follow" />}
  {!noindex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />}

  <!-- hreflang -->
  {hreflang.map(h => (
    <link rel="alternate" hreflang={h.lang} href={h.url} />
  ))}

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
  <meta property="og:site_name" content={lang === 'de' ? 'Zeit-Rechner.com' : 'Time-Calculator.com'} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonical} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />
  <meta name="twitter:site" content="@zeitrechner" />
  <meta name="twitter:creator" content="@zeitrechner" />

  <!-- Theme -->
  <meta name="theme-color" content="#080b14" />
  <meta name="color-scheme" content="dark" />

  <!-- Preconnect & Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </noscript>

  <!-- JSON-LD -->
  {jsonLd.map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>

  <!-- ─── NAVBAR ──────────────────────────────────────────────────────────── -->
  <nav class="navbar" role="navigation" aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
    <div class="navbar__inner">
      <a href={hubUrl} class="navbar__logo" aria-label="Home">
        ⏱ <span>Zeit{lang === 'de' ? 'rechner' : 'Calculator'}</span>
      </a>

      <ul class="navbar__links" role="list">
        {navLinks.map(link => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>

      <div class="navbar__lang">
        <a href={hubUrlDe} class:list={['lang-btn', { active: lang === 'de' }]} hreflang="de" aria-label="Deutsch">DE</a>
        <a href={hubUrlEn} class:list={['lang-btn', { active: lang === 'en' }]} hreflang="en" aria-label="English">EN</a>
      </div>
    </div>
  </nav>

  <!-- ─── MAIN ────────────────────────────────────────────────────────────── -->
  <main id="main-content">
    <slot />
  </main>

  <!-- ─── FOOTER ──────────────────────────────────────────────────────────── -->
  <footer class="footer" role="contentinfo">
    <div class="footer__inner">
      <div class="footer__col">
        <h3>{lang === 'de' ? 'Rechner' : 'Calculators'}</h3>
        <ul>
          <li><a href={lang === 'de' ? '/' : '/en/'}>{lang === 'de' ? 'Zeitrechner' : 'Time Calculator'}</a></li>
          <li><a href={lang === 'de' ? '/stunden-zwischen-9-und-17/' : '/en/hours-between-9-and-5/'}>{lang === 'de' ? 'Stunden 9–17' : 'Hours 9–5'}</a></li>
          <li><a href={lang === 'de' ? '/arbeitsstunden-9-und-17/' : '/en/work-hours-9-and-5/'}>{lang === 'de' ? 'Arbeitsstunden' : 'Work Hours'}</a></li>
          <li><a href={lang === 'de' ? '/tage-bis-weihnachten/' : '/en/days-until-christmas/'}>Countdown</a></li>
          <li><a href={lang === 'de' ? '/alle-rechner/' : '/en/all-calculators/'}>{lang === 'de' ? 'Alle Rechner (Sitemap)' : 'All Calculators (Sitemap)'}</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h3>{lang === 'de' ? 'Beliebt' : 'Popular'}</h3>
        <ul>
          <li><a href={lang === 'de' ? '/stunden-zwischen-8-und-17/' : '/en/hours-between-8-and-5/'}>8–17 Uhr</a></li>
          <li><a href={lang === 'de' ? '/stunden-zwischen-7-und-15/' : '/en/hours-between-7-and-3/'}>7–15 Uhr</a></li>
          <li><a href={lang === 'de' ? '/stunden-zwischen-10-und-18/' : '/en/hours-between-10-and-18/'}>10–18 Uhr</a></li>
          <li><a href={lang === 'de' ? '/stunden-zwischen-9-und-12/' : '/en/hours-between-9-and-12/'}>9–12 Uhr</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h3>{lang === 'de' ? 'Sprache' : 'Language'}</h3>
        <ul>
          <li><a href="/" hreflang="de">🇩🇪 Deutsch</a></li>
          <li><a href="/en/" hreflang="en">🇬🇧 English</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__legal">
      {lang === 'de' ? (
        <>
          <a href="/ueber-uns/">Über uns</a>
          <span class="footer__sep">•</span>
          <a href="/impressum/">Impressum</a>
          <span class="footer__sep">•</span>
          <a href="/datenschutz/">Datenschutz</a>
          <span class="footer__sep">•</span>
          <a href="/nutzungsbedingungen/">Nutzungsbedingungen</a>
          <span class="footer__sep">•</span>
          <a href="/sitemap.xml" target="_blank">XML Sitemap</a>
        </>
      ) : (
        <>
          <a href="/en/about-us/">About Us</a>
          <span class="footer__sep">•</span>
          <a href="/en/imprint/">Imprint</a>
          <span class="footer__sep">•</span>
          <a href="/en/privacy-policy/">Privacy Policy</a>
          <span class="footer__sep">•</span>
          <a href="/en/terms-of-service/">Terms of Service</a>
          <span class="footer__sep">•</span>
          <a href="/sitemap.xml" target="_blank">XML Sitemap</a>
        </>
      )}
    </div>
    <div class="footer__bottom">
      <span>© {currentYear} Zeit-Rechner.com</span>
      <span>{lang === 'de' ? 'Kostenloser Online-Zeitrechner' : 'Free Online Time Calculator'}</span>
    </div>
  </footer>

  <!-- ─── FAQ ACCORDION SCRIPT ─────────────────────────────────────────────── -->
  <script>
    document.querySelectorAll('.faq-item__question').forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        const answer = btn.nextElementSibling as HTMLElement;
        if (answer) answer.classList.toggle('open', !expanded);
      });
    });
  </script>

</body>
</html>
