---
// Embed / share panel (Phase 7.2): Link · Text · HTML, each with a copy button.
// The HTML option is an iframe to /embed/* plus an attribution comment; the
// attribution link is a real <a> to the canonical page.
interface Props { pageUrl: string; embedPath: string; lang?: 'de' | 'en'; title?: string; }
const { pageUrl, embedPath, lang = 'de', title = 'Zeit-Rechner' } = Astro.props as Props;
const base = 'https://zeit-rechner.com';
const embedUrl = `${base}${embedPath}`;

const linkText = pageUrl;
const textSnippet = lang === 'de'
  ? `${title} berechnen auf Zeit-Rechner.com: ${pageUrl}`
  : `Calculate ${title} on Zeit-Rechner.com: ${pageUrl}`;
const htmlSnippet =
  `<iframe src="${embedUrl}" width="100%" height="480" style="border:1px solid #ddd;border-radius:12px" title="${title}"></iframe>\n<!-- ${title} von Zeit-Rechner.com — ${pageUrl} -->`;

const t = lang === 'de'
  ? { h: 'Einbetten & Teilen', link: 'Link', text: 'Text', html: 'HTML (iframe)', copy: 'Kopieren' }
  : { h: 'Embed & share', link: 'Link', text: 'Text', html: 'HTML (iframe)', copy: 'Copy' };

const rows = [
  { label: t.link, value: linkText },
  { label: t.text, value: textSnippet },
  { label: t.html, value: htmlSnippet },
];
const copyIcon = `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
---
<section class="section" style="padding-top: 0;">
  <div class="container container--narrow">
    <div class="embed-panel">
      <h2 style="font-size: 1.2rem; margin: 0 0 1rem;">{t.h}</h2>
      {rows.map((r) => (
        <div class="embed-row">
          <span class="embed-row__label">{r.label}</span>
          <code class="embed-row__value">{r.value}</code>
          <button class="copy-btn" type="button" data-copy={r.value} aria-label={`${r.label} ${t.copy}`} set:html={copyIcon}></button>
        </div>
      ))}
    </div>
  </div>
</section>
