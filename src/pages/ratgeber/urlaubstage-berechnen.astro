---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getHubUrl, getFullUrl } from '../../lib/seoEngine';

const lang = 'de';
const title = 'Urlaubstage berechnen: Rechner & Regeln bei Austritt & Eintritt 2026';
const description = 'Berechnen Sie Ihren Urlaubsanspruch bei Kündigung, Eintritt oder Austritt unterjährig. Kostenloser Urlaubsrechner mit allen gesetzlichen Regeln des BUrlG.';

const canonical = getFullUrl('/ratgeber/urlaubstage-berechnen/');
const hubUrl = getHubUrl(lang);

const hreflang = [
  { lang: 'de', url: canonical },
  { lang: 'x-default', url: canonical },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "headline": "Urlaubstage berechnen: Rechner & Regeln bei Austritt & Eintritt 2026",
        "description": "Erfahren Sie, wie Sie den gesetzlichen Urlaubsanspruch bei Jobwechsel, Eintritt oder Austritt berechnen. Inklusive Rundenregeln nach BUrlG und Rechner.",
        "datePublished": "2026-05-31",
        "dateModified": "2026-08-21",
        "mainEntityOfPage": canonical,
        "author": {
          "@type": "Organization",
          "name": "Zeit-Rechner Redaktion",
          "url": getFullUrl('/ueber-uns/')
        },
        "publisher": {
          "@type": "Organization",
          "name": "Zeit-Rechner.com",
          "logo": {
            "@type": "ImageObject",
            "url": getFullUrl('/favicon.svg')
          }
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Was passiert mit dem Urlaub, wenn ich in der ersten Jahreshälfte kündige?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Scheiden Arbeitnehmer/innen vor dem 30. Juni (erste Jahreshälfte) aus dem Unternehmen aus, haben sie nach § 5 Abs. 1c BUrlG Anspruch auf ein Zwölftel des Jahresurlaubs für jeden vollen Monat des Bestehens des Arbeitsverhältnisses."
            }
          },
          {
            "@type": "Question",
            "name": "Habe ich bei Austritt in der zweiten Jahreshälfte Anspruch auf den vollen Urlaub?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. Scheiden Arbeitnehmer/innen nach dem 30. Juni (zweite Jahreshälfte) aus und haben die sechsmonatige Wartezeit (§ 4 BUrlG) erfüllt, steht ihnen der volle gesetzliche Mindesturlaub (20 Tage bei einer 5-Tage-Woche) zu. Vertraglicher Zusatzurlaub kann jedoch vertraglich zeitanteilig gekürzt werden."
            }
          },
          {
            "@type": "Question",
            "name": "Wie werden halbe Urlaubstage gerundet?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Gemäß § 5 Abs. 2 BUrlG sind Bruchteile von Urlaubstagen, die mindestens einen halben Tag ergeben (also >= 0,5), auf volle Urlaubstage aufzurunden. Bruchteile unter 0,5 Tage dürfen nicht abgerundet werden, sondern müssen tageweise im Bruchteil gewährt oder ausbezahlt werden."
            }
          },
          {
            "@type": "Question",
            "name": "Kann Resturlaub verfallen?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Grundsätzlich muss Urlaub im laufenden Kalenderjahr genommen werden. Eine Übertragung auf das Folgejahr bis zum 31. März ist nur aus dringenden betrieblichen oder persönlichen Gründen zulässig. Nach der BAG-Rechtsprechung verfällt der Urlaub jedoch nur dann, wenn der Arbeitgeber die Arbeitnehmer/innen rechtzeitig und konkret aufgefordert hat, den Urlaub zu nehmen, und auf den drohenden Verfall hingewiesen hat."
            }
          },
          {
            "@type": "Question",
            "name": "Wie hoch ist der gesetzliche Mindesturlaub?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Nach § 3 BUrlG beträgt der gesetzliche Mindesturlaub 24 Werktage bei einer 6-Tage-Woche. Umgerechnet auf eine übliche 5-Tage-Woche entspricht das exakt 20 Urlaubstagen pro Kalenderjahr."
            }
          }
        ]
      }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  hreflang={hreflang}
  lang={lang}
  jsonLd={jsonLd}
  theme="guide"
>

  <section class="section landing-hero" style="padding-bottom: 2rem;">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={hubUrl}>Home</a>
        <span class="breadcrumb__sep">›</span>
        <a href="/ratgeber/">Ratgeber</a>
        <span class="breadcrumb__sep">›</span>
