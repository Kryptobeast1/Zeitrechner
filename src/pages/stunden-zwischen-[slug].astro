---
// Programmatic page: /stunden-zwischen-[slug]/
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkHoursCalc from '../components/calculator/WorkHoursCalc';
import Tagesband from '../components/Tagesband.astro';
import { ALL_TIME_RANGES, INDEXED_RANGES, formatHour24, formatHour12, getRangeHours, getSimilarRanges } from '../data/timeRanges';
import type { TimeRange } from '../data/timeRanges';
import {
  buildSEOMeta, buildFAQSchema, buildBreadcrumbSchema,
  getTimeRangeUrl, getHubUrl, getWorkHoursUrl, shouldIndex
} from '../lib/seoEngine';
import {
  timeRangeIntros_de, getContextClusterDE, useCases_de, faqSets_de,
  workHoursFaqSets_de, variantIndex
} from '../data/contentVariants';
import { computeShiftFromHours } from '../lib/shift';
import { shouldNoindexByDemand } from '../lib/keepList';

export async function getStaticPaths() {
  // Only the canonical German slug is built. Legacy English-convention slugs
  // are 301'd at the edge via vercel.json (see scripts/gen-redirects.ts) — no
  // client-side meta-refresh interstitials are generated.
  return ALL_TIME_RANGES.map(range => ({ params: { slug: range.deSlug }, props: { range } }));
}

interface Props { range: TimeRange; }
const { range } = Astro.props as Props;

const lang = 'de';
const hours = getRangeHours(range.start, range.end);
const start24 = formatHour24(range.start);
const end24 = formatHour24(range.end);

// Single source of truth for the displayed result figures (Phase 1)
const gross = computeShiftFromHours(range.start, range.end, 0, 'de');

// Phase 3.3: this page now also answers net-after-break (merged work-hours content)
const BREAK_OPTIONS = [0, 30, 45, 60];
const breakResults = BREAK_OPTIONS.map(b => ({ break: b, result: computeShiftFromHours(range.start, range.end, b, 'de') }));
const net30 = breakResults[1].result;
const bandBreak = gross.grossMin > 360 ? 30 : 0; // only show a break notch when one would legally apply

const canonical = getTimeRangeUrl(lang, range.deSlug);
const altUrl = getTimeRangeUrl('en', range.slug);

const hreflang = [
  { lang: 'de', url: canonical },
  { lang: 'en', url: altUrl },
  { lang: 'x-default', url: altUrl },
];

// Choose variant by slug hash
const vi = variantIndex(range.deSlug, timeRangeIntros_de.length);
const ui = variantIndex(range.deSlug + 'use', useCases_de.length);
const fi = variantIndex(range.deSlug + 'faq', faqSets_de.length);

const introHtml = timeRangeIntros_de[vi](start24, end24, hours);
const contextText = getContextClusterDE(range.start, range.end, hours);
const useCaseList = useCases_de[ui];
// Merged FAQ: time-range questions + net-after-break (ArbZG) questions
const faqs = [
  ...faqSets_de[fi](start24, end24, hours),
  ...workHoursFaqSets_de[0](start24, end24, net30.netDecimal),
];

const similarRanges = getSimilarRanges(range, 8);

const seoMeta = buildSEOMeta(
  'time-range', lang,
  { start: start24, end: end24, hours: hours.toString() },
  canonical, 'en', altUrl,
  !shouldIndex('time-range', range.demandScore) || shouldNoindexByDemand(canonical),
);

const jsonLd = [
  buildFAQSchema(faqs),
  buildBreadcrumbSchema([
    { name: 'Startseite', url: getHubUrl(lang) },
    { name: `${hours} Stunden (${start24}–${end24})`, url: canonical },
  ]),
];

const useCaseIcons = ['', '', '', '', '', ''];

const lastUpdated = new Date().toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={seoMeta.title}
  description={seoMeta.description}
  canonical={seoMeta.canonical}
  hreflang={seoMeta.hreflang}
  noindex={seoMeta.noindex}
  lang={lang}
  jsonLd={jsonLd}
  ogImage={seoMeta.ogImage}
  ogImageAlt={seoMeta.ogImageAlt}
  theme="time-range"
>

  <!-- ─── HERO & DASHBOARD GRID ─────────────────────────────────────────── -->
  <section class="section landing-hero" style="padding-bottom: 2rem;">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">›</span>
        <span aria-current="page">Stunden zwischen {start24} und {end24}</span>
      </nav>

      <div class="dashboard-grid" style="margin-top: 1.5rem; align-items: center;">
        <!-- Left: Clock Visualizer -->
        <div class="glass glass--raised" style="padding: 2rem; text-align: center; border-radius: var(--radius-xl);">
          <div class="time-arc-wrapper">
            <svg class="time-arc-svg" viewBox="0 0 80 80">
              <circle class="time-arc-bg" cx="40" cy="40" r="35" />
              <circle class="time-arc-active" cx="40" cy="40" r="35"
                stroke-dasharray={`${(hours / 24) * 219.91} 219.91`}
                transform={`rotate(${range.start * 15} 40 40)`}
              />
            </svg>
            <div class="time-arc-label">
              <span>{hours}h</span>
              <span class="time-arc-sublabel">Dauer</span>
            </div>
          </div>
          <div style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--clr-text-2);">
            Start: {start24} Uhr • Ende: {end24} Uhr
          </div>
        </div>

        <!-- Right: Text & Featured Snippet -->
        <div>
          <div class="landing-hero__meta" style="margin-bottom: 1rem;">
            {range.workShift && <span class="badge badge--green">Schichtzeit</span>}
            <span class="badge badge--accent">{gross.grossDecimalStr}h Ergebnis</span>
          </div>

          <h1 style="font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 1.5rem; line-height: 1.3;">Wie viele Stunden von {start24} bis {end24} Uhr?</h1>

          <div class="featured-snippet" role="complementary" aria-label="Schnellantwort" style="margin: 0;">
            <div class="featured-snippet__label">Schnellantwort</div>
            <div class="featured-snippet__answer"><span data-result="gross-hours">{gross.grossDecimalStr}</span> Stunden</div>
            <p class="featured-snippet__sentence" style="margin-top: var(--space-2); margin-bottom: 0;">
              Von {start24} bis {end24} Uhr sind es genau <strong>{gross.grossDecimalStr} Stunden</strong> (<span data-result="gross-minutes">{gross.grossMin}</span> Minuten / <span data-result="gross-seconds">{gross.grossMin * 60}</span> Sekunden).
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── TAGESBAND (signature element) ──────────────────────────────────── -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <figure class="tagesband-figure">
        <Tagesband start={range.start} end={range.end} breakMin={bandBreak} lang="de" />
      </figure>
    </div>
  </section>

  <!-- ─── RESULT TRIPTYCH ────────────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="result-triptych">
        <div class="result-card">
          <span class="result-card__label">Std:Min</span>
          <span class="result-card__value" data-result="gross-hours-hhmm">{gross.grossHHMM}</span>
          <button class="copy-btn" type="button" data-copy={gross.grossHHMM} aria-label="Std:Min kopieren">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>
        <div class="result-card">
          <span class="result-card__label">Industriezeit <span class="result-card__hint">für Gehaltsabrechnungen</span></span>
          <span class="result-card__value" data-result="gross-decimal">{gross.grossDecimalStr}</span>
          <button class="copy-btn" type="button" data-copy={gross.grossDecimalStr} aria-label="Industriezeit kopieren">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>
        <div class="result-card">
          <span class="result-card__label">Minuten</span>
          <span class="result-card__value" data-result="gross-minutes">{gross.grossMin}</span>
          <button class="copy-btn" type="button" data-copy={String(gross.grossMin)} aria-label="Minuten kopieren">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── NETTOARBEITSZEIT (merged work-hours content, Phase 3.3) ─────────── -->
  <section class="section" style="padding-top: 0;" id="arbeitszeit">
    <div class="container container--narrow">
      <div class="payroll-sheet">
        <h2 style="margin-top: 0; margin-bottom: 8px; font-size: 1.3rem;">Nettoarbeitszeit von {start24} bis {end24} Uhr (nach Pause)</h2>
        <p style="margin-top: 0; margin-bottom: 20px; color: var(--clr-text-2); font-size: 0.95rem;">
          Als Arbeitsschicht ergeben {start24}–{end24} Uhr <strong><span data-result="net-hhmm-30">{net30.netHHMM}</span></strong>
          Nettoarbeitszeit mit 30 Minuten Pause — das sind <strong><span data-result="net-decimal-30">{net30.netDecimalStr}</span> Dezimalstunden</strong> für die Lohnabrechnung.
        </p>
        {breakResults.map(br => {
          const pct = br.result.grossMin > 0 ? (br.result.netMin / br.result.grossMin) * 100 : 0;
          return (
            <div class="payroll-row">
              <div class="payroll-info">
                <span class="payroll-label">{br.break === 0 ? 'Ohne Pause' : `${br.break} Min. Pause`}</span>
                <span class="payroll-val">
                  <span data-result={`net-hhmm-${br.break}`}>{br.result.netHHMM}</span> (<span data-result={`net-decimal-${br.break}`}>{br.result.netDecimalStr}</span>h)
                </span>
              </div>
              <div class="payroll-bar-track">
                <div class="payroll-bar-fill" style={`width: ${pct}%`} />
              </div>
            </div>
          );
        })}
        <p style="margin-top: 16px; margin-bottom: 0; font-size: 0.85rem; color: var(--clr-text-3);">
          Gemäß Arbeitszeitgesetz (ArbZG) sind ab 6 Stunden mindestens 30 Minuten und ab 9 Stunden 45 Minuten Pause abzuziehen.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── CONTENT ────────────────────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <div class="content-section">
        <h2>Berechnung der Zeitspanne von {start24} bis {end24} Uhr</h2>
        <div class="content-prose">
          <p set:html={introHtml} />
          <p>{contextText}</p>
          
          <div class="expert-box" style="margin-top: 40px; padding: 24px; background: var(--clr-surf-2); border-radius: 12px; border: 1px solid var(--clr-border);">
            <h3 style="margin-top: 0;">Technische Präzision & Zeitmessung</h3>
            <p>
              In der modernen Zeitrechnung basiert die Bestimmung von Zeitdifferenzen auf dem <strong>sexagesimalen System</strong> (Basis 60). 
              Während wir im Alltag oft in Stunden und Minuten denken, rechnet unser System intern mit Millisekunden-Offsets, um auch 
              komplexe Szenarien wie den Übergang von 23:59 auf 00:00 Uhr (Mitternacht) fehlerfrei abzubilden.
            </p>
            <p style="margin-top: 15px; margin-bottom: 0; font-size: 0.9rem; color: var(--clr-text-3);">
              <em>Wussten Sie schon? Eine präzise Zeitmessung ist nicht nur für die Astronomie, sondern auch für die Synchronisation 
              von Servernetzwerken und die moderne Logistik unerlässlich.</em>
            </p>
          </div>
        </div>
      </div>

      <!-- Use cases -->
      <div class="content-section">
        <h2>Anwendungsfälle</h2>
        <div class="use-cases">
          {useCaseList.map((uc, i) => (
            <a href={`#faq-${i % faqs.length}`} class="use-case-item">
              <span class="use-case-item__icon">{useCaseIcons[i % useCaseIcons.length]}</span>
              <span class="use-case-item__text">{uc}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── EMBEDDED CALCULATOR ────────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <div class="embedded-calc">
        <div class="embedded-calc__header">
          <div class="embedded-calc__title">Selbst berechnen</div>
          <div class="embedded-calc__subtitle">Passe Start- und Endzeit an für eigene Berechnungen</div>
        </div>
        <WorkHoursCalc client:visible lang="de"
          defaultStart={`${String(range.start).padStart(2,'0')}:00`}
          defaultEnd={`${String(range.end).padStart(2,'0')}:00`}
          defaultBreak={0}
        />
      </div>
    </div>
  </section>

  <!-- ─── FAQ ────────────────────────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0;" id="faq-section">
    <div class="container container--narrow">
      <div class="content-section">
        <h2>Häufig gestellte Fragen</h2>
        <div class="faq-list" itemscope itemtype="https://schema.org/FAQPage">
          {faqs.map((faq, idx) => (
            <div class="faq-item" id={`faq-${idx}`} itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
              <button class="faq-item__question" aria-expanded="false" itemprop="name" aria-controls={`faq-answer-${idx}`}>
                {faq.q}
                <span class="faq-arrow" aria-hidden="true">▾</span>
              </button>
              <div class="faq-item__answer" id={`faq-answer-${idx}`} aria-hidden="true" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <span itemprop="text">{faq.a}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── INTERNAL LINKS ─────────────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="internal-links">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.2rem; margin: 0;">Ähnliche Zeitspannen</h2>
        </div>
        <div class="link-grid">
          {similarRanges.map(r => {
            const h = getRangeHours(r.start, r.end);
            return (
              <a href={getTimeRangeUrl(lang, r.deSlug)} class="link-card">
                <span>Stunden zwischen {formatHour24(r.start)} und {formatHour24(r.end)} ({h}h)</span>
                <span class="link-card__arrow">→</span>
              </a>
            );
          })}
          <a href="#arbeitszeit" class="link-card">
            <span>Arbeitsstunden {start24} – {end24} (Netto nach Pause)</span>
            <span class="link-card__arrow">→</span>
          </a>
          <a href={getHubUrl(lang)} class="link-card">
            <span>← Zurück zum Zeitrechner</span>
            <span class="link-card__arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
