---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArbZGTool from '../components/tools/ArbZGTool';
import { getHubUrl, getFullUrl, buildBreadcrumbSchema, buildFAQSchema } from '../lib/seoEngine';
const lang = 'de';
const canonical = '/pausenrechner/';
const faqs = [
  { q: 'Wie viel Pause ist gesetzlich vorgeschrieben?', a: 'Nach § 4 Arbeitszeitgesetz (ArbZG) sind bei mehr als 6 Stunden Arbeit mindestens 30 Minuten und bei mehr als 9 Stunden mindestens 45 Minuten Pause vorgeschrieben. Bis einschließlich 6 Stunden besteht keine gesetzliche Pausenpflicht.' },
  { q: 'Zählt die Pause zur Arbeitszeit?', a: 'Nein. Ruhepausen im Sinne des § 4 ArbZG sind unbezahlt und zählen nicht zur Arbeitszeit. Sie müssen die Arbeit unterbrechen und dürfen nicht an deren Anfang oder Ende gelegt werden – man darf also nicht einfach 30 Minuten später anfangen oder früher gehen.' },
  { q: 'Darf ich die Pause in mehrere Abschnitte aufteilen?', a: 'Ja. Die vorgeschriebene Pause kann in Zeitabschnitte von jeweils mindestens 15 Minuten aufgeteilt werden. Zwei Pausen von je 15 Minuten erfüllen also die 30-Minuten-Pflicht, drei 15-Minuten-Blöcke die 45-Minuten-Pflicht.' },
  { q: 'Was passiert, wenn keine Pause gemacht wird?', a: 'Überschreitet die Arbeitszeit 6 Stunden, wird die gesetzliche Mindestpause in der Zeiterfassung in der Regel automatisch abgezogen. Der Arbeitgeber ist zur Überwachung verpflichtet; bei Verstößen drohen Bußgelder nach § 22 ArbZG. Die Pausenpflicht dient dem Gesundheitsschutz und ist nicht verhandelbar.' },
  { q: 'Gelten für Jugendliche andere Pausenregeln?', a: 'Ja. Für Jugendliche unter 18 gilt das Jugendarbeitsschutzgesetz (JArbSchG). Es schreibt strengere Pausen vor: mindestens 30 Minuten bei einer Arbeitszeit von 4,5 bis 6 Stunden und mindestens 60 Minuten bei mehr als 6 Stunden.' },
  { q: 'Ist die Raucherpause eine gesetzliche Pause?', a: 'Nein. Eine Raucherpause ist keine Ruhepause nach § 4 ArbZG, sondern eine Unterbrechung der Arbeitszeit. Sie wird in der Regel ausgestempelt und nicht vergütet, sofern die Betriebsvereinbarung nichts Günstigeres regelt.' },
];
const jsonLd = [buildFAQSchema(faqs), buildBreadcrumbSchema([{ name: 'Startseite', url: getHubUrl(lang) }, { name: 'Pausenrechner', url: canonical }])];
---
<BaseLayout title="Pausenrechner (ArbZG) — gesetzliche Pause & Nettozeit berechnen" description="Berechne die gesetzlich vorgeschriebene Pause nach § 4 ArbZG (30 Min ab 6 Std, 45 Min ab 9 Std) und die korrigierte Nettoarbeitszeit. Mit Pausentabelle, Beispielen und FAQ." canonical={getFullUrl(canonical)} hreflang={[{ lang: 'de', url: getFullUrl(canonical) }, { lang: 'en', url: getFullUrl('/en/break-rules-germany/') }, { lang: 'x-default', url: getFullUrl(canonical) }]} langAlternates={{ de: canonical, en: '/en/break-rules-germany/' }} lang={lang} jsonLd={jsonLd} theme="info">
  <section class="section landing-hero" style="padding-bottom: 1.5rem;">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="breadcrumb__sep">›</span><span aria-current="page">Pausenrechner</span></nav>
      <div style="margin-top: 1.5rem; max-width: 760px;">
        <h1 style="margin-bottom: 0.75rem;">Pausenrechner nach ArbZG</h1>
        <p class="landing-hero__lead">Wie viel Pause ist Pflicht – und wie viel Nettoarbeitszeit bleibt? Der Rechner wendet § 4 Arbeitszeitgesetz an: 30 Minuten ab mehr als 6 Stunden, 45 Minuten ab mehr als 9 Stunden.</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;"><div class="container container--narrow"><div class="glass" style="padding: 1.5rem; border-radius: var(--radius);"><ArbZGTool client:idle mode="pause" /></div></div></section>

  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <div class="content-section content-prose">
        <h2>Die gesetzliche Pausenregelung auf einen Blick</h2>
        <p>
          Eine <strong>Ruhepause</strong> ist eine im Voraus feststehende Unterbrechung der Arbeit zur Erholung. Nach
          <strong>§ 4 Arbeitszeitgesetz (ArbZG)</strong> hängt die Mindestdauer allein von der täglichen Arbeitszeit ab –
          nicht vom Beruf und nicht vom Wunsch der Beschäftigten. Entscheidend ist die reine Arbeitszeit (Bruttozeit ohne bereits
          genommene Pausen).
        </p>

        <div style="overflow-x: auto; margin: 20px 0;">
          <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem; text-align: left; min-width: 460px;">
            <thead>
              <tr style="border-bottom: 2px solid var(--rule);">
                <th style="padding: 10px;">Tägliche Arbeitszeit</th>
                <th style="padding: 10px;">Mindestpause</th>
                <th style="padding: 10px;">Aufteilbar in</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid var(--rule);"><td style="padding: 10px;">bis 6 Stunden</td><td style="padding: 10px;">keine Pflicht</td><td style="padding: 10px;">–</td></tr>
              <tr style="border-bottom: 1px solid var(--rule);"><td style="padding: 10px;">mehr als 6 bis 9 Stunden</td><td style="padding: 10px;"><strong>30 Minuten</strong></td><td style="padding: 10px;">2 × 15 Minuten</td></tr>
              <tr style="border-bottom: 1px solid var(--rule);"><td style="padding: 10px;">mehr als 9 Stunden</td><td style="padding: 10px;"><strong>45 Minuten</strong></td><td style="padding: 10px;">3 × 15 Minuten</td></tr>
            </tbody>
          </table>
        </div>

        <h3>Rechenbeispiel: 08:00 bis 17:00 Uhr</h3>
        <p>
          Von 08:00 bis 17:00 Uhr beträgt die Anwesenheit <strong>9 Stunden</strong> (Bruttozeit). Da die Arbeitszeit über
          6 Stunden liegt, sind mindestens 30 Minuten Pause abzuziehen. Die <strong>Nettoarbeitszeit</strong> beträgt somit
          8 Stunden 30 Minuten, also <code>8,5 Dezimalstunden</code>. Erst ab <em>mehr</em> als 9 Stunden – etwa 08:00 bis
          17:30 Uhr – greift die 45-Minuten-Pflicht.
        </p>

        <h3>Wichtige Regeln zur Pause</h3>
        <ul>
          <li>Die Pause muss <strong>vor Arbeitsbeginn feststehen</strong> und die Arbeit tatsächlich unterbrechen.</li>
          <li>Sie darf <strong>nicht an Anfang oder Ende</strong> der Schicht gelegt werden (kein „später kommen, früher gehen“).</li>
          <li>Niemand darf <strong>länger als 6 Stunden ohne Pause</strong> beschäftigt werden (§ 4 Satz 3 ArbZG).</li>
          <li>Ruhepausen sind <strong>unbezahlt</strong> und zählen nicht zur Arbeitszeit – anders als kurze bezahlte „Kurzpausen“ mancher Tarifverträge.</li>
          <li>Für <strong>Jugendliche</strong> gelten strengere Werte nach dem JArbSchG (30 Min. ab 4,5 Std., 60 Min. ab mehr als 6 Std.).</li>
        </ul>
      </div>

      <div class="internal-links" style="margin-top: 32px;">
        <div class="internal-links__header"><h2 class="internal-links__title" style="font-size: 1.2rem; margin: 0;">Passende Rechner & Ratgeber</h2></div>
        <div class="link-grid">
          <a href="/ruhezeit-checker/" class="link-card"><span>Ruhezeit-Checker (11 Stunden, § 5 ArbZG)</span><span class="link-card__arrow">→</span></a>
          <a href="/nachtzuschlag-rechner/" class="link-card"><span>Nachtzuschlag-Rechner (23–06 Uhr)</span><span class="link-card__arrow">→</span></a>
          <a href="/ratgeber/arbeitszeit-berechnen/" class="link-card"><span>Guide: Arbeitszeit berechnen</span><span class="link-card__arrow">→</span></a>
          <a href={getHubUrl(lang)} class="link-card"><span>Zum Arbeitsstunden-Rechner</span><span class="link-card__arrow">→</span></a>
        </div>
      </div>

      <div class="content-section"><h2>Häufig gestellte Fragen</h2>
        <div class="faq-list" itemscope itemtype="https://schema.org/FAQPage">
          {faqs.map(f => (
            <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
              <button class="faq-item__question" aria-expanded="false" itemprop="name">{f.q}<span class="faq-arrow" aria-hidden="true">▾</span></button>
              <div class="faq-item__answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer"><span itemprop="text">{f.a}</span></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
