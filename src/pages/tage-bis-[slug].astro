---
// /tage-bis-[slug]/
import BaseLayout from '../layouts/BaseLayout.astro';
import CountdownCalc from '../components/calculator/CountdownCalc';
import { ALL_EVENTS, INDEXED_EVENTS, getDaysUntil, getNextOccurrence } from '../data/dateEvents';
import type { DateEvent } from '../data/dateEvents';
import { buildSEOMeta, buildFAQSchema, buildBreadcrumbSchema, getCountdownUrl, getHubUrl } from '../lib/seoEngine';
import { countdownIntros_de, variantIndex } from '../data/contentVariants';

export async function getStaticPaths() {
  const paths = [];
  for (const event of ALL_EVENTS) {
    paths.push({ params: { slug: event.deSlug }, props: { event } });
    if (event.slug !== event.deSlug) {
      paths.push({ params: { slug: event.slug }, props: { event } });
    }
  }
  return paths;
}

interface Props { event: DateEvent; }
const { event } = Astro.props as Props;
const { slug } = Astro.params;

// 301 Redirect to German slug if English slug is used on a German page
if (slug === event.slug && event.slug !== event.deSlug) {
  return Astro.redirect(getCountdownUrl('de', event.deSlug), 301);
}

const lang = 'de';
const { date: activeTargetDate, yearShift } = getNextOccurrence(event.targetDate);
const days = Math.max(0, getDaysUntil(event.targetDate));

// Dynamic display name if year shifted
let displayName = event.deName;
const currentTargetYear = new Date(activeTargetDate).getFullYear();
if (yearShift > 0) {
  if (/20\d{2}/.test(displayName)) {
    // Replace old year with new year
    displayName = displayName.replace(/20\d{2}/, currentTargetYear.toString());
  } else {
    // Append year if not present
    displayName = `${displayName} ${currentTargetYear}`;
  }
}

const canonical = getCountdownUrl(lang, event.deSlug);
const altUrl = getCountdownUrl('en', event.slug);

const hreflang = [
  { lang: 'de', url: canonical },
  { lang: 'en', url: altUrl },
  { lang: 'x-default', url: altUrl },
];

const vi = variantIndex(event.deSlug, countdownIntros_de.length);
const introHtml = countdownIntros_de[vi](displayName, days);

const seoMeta = buildSEOMeta(
  'countdown', lang,
  { name: displayName, days: days.toString() },
  canonical, 'en', altUrl,
);

const faqs = [
  { q: `Wie viele Stunden bis ${displayName}?`, a: `Es sind noch ${days * 24} Stunden bis ${displayName} (${activeTargetDate}).` },
  { q: `Wie viele Minuten bis ${displayName}?`, a: `Noch ${(days * 24 * 60).toLocaleString('de-DE')} Minuten bis ${displayName}.` },
  { q: `Was ist das genaue Datum von ${displayName}?`, a: `${displayName} fällt auf den ${new Date(activeTargetDate).toLocaleDateString('de-DE', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}.` },
];

const jsonLd = [
  buildFAQSchema(faqs),
  buildBreadcrumbSchema([
    { name: 'Startseite', url: getHubUrl(lang) },
    { name: `Tage bis ${displayName}`, url: canonical },
  ]),
];

// Related events
const relatedEvents = INDEXED_EVENTS.filter(e => e.deSlug !== event.deSlug && e.category === event.category).slice(0, 6);

const lastUpdated = new Date().toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={seoMeta.title}
  description={seoMeta.description}
  canonical={canonical}
  hreflang={hreflang}
  lang={lang}
  jsonLd={jsonLd}
>

  <section class="section landing-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">›</span>
        <span aria-current="page">Tage bis {displayName}</span>
      </nav>

      <div class="landing-hero__meta">
        <span class="badge badge--violet">⏳ Countdown</span>
        <span class="badge badge--accent">{days} Tage</span>
        <span class="last-updated">Live aktualisiert: {lastUpdated}</span>
      </div>

      <h1>Wie viele Tage bis {displayName}?</h1>

      <div class="featured-snippet">
        <div class="featured-snippet__label">Schnellantwort</div>
        <div class="featured-snippet__answer">{days} Tage</div>
        <p class="featured-snippet__sentence" set:html={introHtml} />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="stat-grid">
        <div class="stat-card">
          <span class="stat-card__value">{days}</span>
          <span class="stat-card__label">Tage</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">{(days * 24).toLocaleString('de-DE')}</span>
          <span class="stat-card__label">Stunden</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">{Math.floor(days / 7)}</span>
          <span class="stat-card__label">Wochen</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">{new Date(activeTargetDate).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit' })}</span>
          <span class="stat-card__label">Datum</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Live countdown -->
  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <div class="embedded-calc">
        <div class="embedded-calc__header">
          <div class="embedded-calc__title">Live-Countdown bis {displayName}</div>
          <div class="embedded-calc__subtitle">Aktualisiert jede Sekunde</div>
        </div>
        <CountdownCalc client:load lang="de"
          defaultTarget={activeTargetDate}
          eventName={displayName}
        />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <h2 style="margin-bottom: 20px;">Häufig gestellte Fragen</h2>
      <div class="faq-list">
        {faqs.map(faq => (
          <div class="faq-item">
            <button class="faq-item__question" aria-expanded="false">
              {faq.q}
              <span class="faq-arrow">▾</span>
            </button>
            <div class="faq-item__answer">{faq.a}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {relatedEvents.length > 0 && (
    <section class="section" style="padding-top: 0;">
      <div class="container">
        <div class="internal-links">
          <div class="internal-links__header">
            <h2 class="internal-links__title" style="font-size: 1.2rem; margin: 0;">⏳ Ähnliche Countdowns</h2>
          </div>
          <div class="link-grid">
            {relatedEvents.map(e => {
              const d = getDaysUntil(e.targetDate);
              return (
                <a href={getCountdownUrl(lang, e.deSlug)} class="link-card">
                  <span>Tage bis {e.deName} ({d} Tage)</span>
                  <span class="link-card__arrow">→</span>
                </a>
              );
            })}
            <a href={getHubUrl(lang)} class="link-card">
              <span>← Zurück zum Zeitrechner</span>
              <span class="link-card__arrow">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

</BaseLayout>
