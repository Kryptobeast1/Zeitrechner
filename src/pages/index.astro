---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModeTabbar from '../components/calculator/ModeTabbar';
import { buildWebAppSchema, buildBreadcrumbSchema, getHubUrl, getTimeRangeUrl, getWorkHoursUrl, getCountdownUrl, getGuideUrl, getFullUrl } from '../lib/seoEngine';
import { INDEXED_RANGES, formatHour24 } from '../data/timeRanges';
import { INDEXED_EVENTS } from '../data/dateEvents';
import { computeShiftFromHours } from '../lib/shift';

// Worked example figures — derived, never hardcoded (Phase 1.2)
const example = computeShiftFromHours(9, 17, 30, 'de'); // 09:00–17:00, 30 min break
const fullDay = computeShiftFromHours(0, 0, 0, 'de');    // full 24h cycle

const lang = 'de';
const canonical = getHubUrl(lang); // "/"
const altUrl = getHubUrl('en'); // "/en/"
const lastUpdated = new Date().toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });

const homeFaqsDe = [
  { q: 'Wie berechne ich Industrieminuten und Dezimalstunden?', a: 'Teilen Sie die normalen Minuten durch 60. Eine halbe Stunde (30 Minuten) entspricht 0,5 Dezimalstunden. Unser Arbeitsstunden-Rechner konvertiert dies automatisch für Ihre Lohnabrechnung.' },
  { q: 'Berücksichtigt der Zeitrechner Sommer- und Winterzeit (DST)?', a: 'Ja. Zeitdifferenzen und Countdowns greifen auf den lokalen Zeitzonenoffset Ihres Browsers zurück und berechnen Schaltjahre sowie die Sommerzeit (DST) fehlerfrei.' },
  { q: 'Muss die gesetzliche Pause abgezogen werden?', a: 'Gemäß Arbeitszeitgesetz (ArbZG) müssen bei über 6 Stunden Arbeit 30 Minuten und bei über 9 Stunden 45 Minuten Pause abgezogen werden. Im Rechner lassen sich gesetzliche Pausen direkt eintragen.' }
];

const hreflang = [
  { lang: 'de', url: getFullUrl(canonical) },
  { lang: 'en', url: getFullUrl(altUrl) },
  { lang: 'x-default', url: getFullUrl(altUrl) },
];

const jsonLd = [
  buildWebAppSchema(lang),
  buildBreadcrumbSchema([
    { name: 'Startseite', url: canonical },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaqsDe.map(faq => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  }
];

// Popular ranges for links
const popularRanges = INDEXED_RANGES.filter(r => r.priority === 'high').slice(0, 9);
const popularEvents = INDEXED_EVENTS.filter(e => e.priority === 'high').slice(0, 6);

const currentTime = new Date().toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
---

<BaseLayout
  title={`Zeitrechner ${new Date().getFullYear()} — Stunden, Arbeitszeit & Countdown online`}
  description="Präziser Zeitrechner für 2026. Berechne Zeitdifferenzen, Arbeitsstunden mit Pausen und Live-Countdowns. Kostenlos & mobil-optimiert."
  canonical={getFullUrl(canonical)}
  hreflang={hreflang}
  lang={lang}
  jsonLd={jsonLd}
  theme="home"
>

  <!-- ─── HERO (centered, calculator-first) ──────────────────────────────── -->
  <section class="section landing-hero" style="padding-bottom: 2rem;">
    <div class="container">
      <div class="hero-centered">
        <div class="landing-hero__meta">
          <span class="badge badge--accent">Kostenlos</span>
          <span class="badge badge--violet">Deutsch</span>
          <span class="badge badge--green">DST-sicher</span>
        </div>

        <h1 style="margin-bottom: 1.25rem;">Zeitrechner — Stunden, Zeiten & Countdowns</h1>

        <p class="landing-hero__lead">
          Berechne Zeitdifferenzen, addiere Stunden, ermittle Nettoarbeitszeiten und zähle Tage bis zu wichtigen Ereignissen.
          <strong>5 Modi, sofortige Ergebnisse, keine Registrierung.</strong>
        </p>

        <!-- Calculator -->
        <div class="home-hero-calc calc-shell" id="differenz">
          <div class="glass glass--raised">
            <ModeTabbar client:visible lang="de" />
          </div>
        </div>

        <!-- Live time (client-only; no build-time value is baked into the HTML) -->
        <div class="live-chip">
          <span>Aktuelle Zeit:</span>
          <span id="live-time" aria-live="off"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FEATURED SNIPPETS ──────────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="stat-grid">
        <div class="stat-card">
          <span class="stat-card__value">{example.grossDecimal}h</span>
          <span class="stat-card__label">Stunden von 9 bis 17 Uhr</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">{example.netDecimalStr}h</span>
          <span class="stat-card__label">Netto (30 Min Pause)</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">{example.grossMin}</span>
          <span class="stat-card__label">Minuten Standardarbeitstag</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">{fullDay.grossDecimal}h</span>
          <span class="stat-card__label">Ein vollständiger Zyklus</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── POPULAR TIME RANGES ────────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0;" id="arbeit">
    <div class="container">
      <div class="internal-links" id="zeiten">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.4rem; margin: 0;">Beliebte Zeitspannen</h2>
        </div>
        <div class="link-grid">
          {popularRanges.map(r => (
            <a href={getTimeRangeUrl(lang, r.deSlug)} class="link-card">
              <span>Stunden zwischen {formatHour24(r.start)} und {formatHour24(r.end)}</span>
              <span class="link-card__arrow">→</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Arbeitsstunden Section -->
      <div class="internal-links" id="arbeitsstunden" style="margin-top: 32px;">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.4rem; margin: 0;">Arbeitsstunden-Rechner</h2>
        </div>
        <div class="link-grid">
          {INDEXED_RANGES.filter(r => r.workShift).map(r => (
            <a href={`${getTimeRangeUrl(lang, r.deSlug)}#arbeitszeit`} class="link-card">
              <span>Arbeitsstunden {formatHour24(r.start)} – {formatHour24(r.end)}</span>
              <span class="link-card__arrow">→</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Guides Section -->
      <section class="guides-section">
        <h3>Ratgeber & Ressourcen</h3>
        <div class="link-grid">
          <a href={getGuideUrl(lang, 'arbeitszeit-berechnen')} class="glass-card link-item">
            <span class="icon"></span>
            <div class="link-info">
              <span class="label">Arbeitszeit berechnen</span>
              <span class="sub">Der komplette Guide 2026</span>
            </div>
          </a>
          <a href={getGuideUrl(lang, 'zeiterfassung-freelancer')} class="glass-card link-item">
            <span class="icon"></span>
            <div class="link-info">
              <span class="label">Freelancer Zeiterfassung</span>
              <span class="sub">Tipps für produktive Arbeit</span>
            </div>
          </a>
        </div>
      </section>

      <!-- Internal Link Mesh -->
      <div class="internal-links" style="margin-top: 32px;" id="countdown">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.4rem; margin: 0;">Countdown-Timer</h2>
        </div>
        <div class="link-grid">
          {popularEvents.map(e => (
            <a href={getCountdownUrl(lang, e.deSlug)} class="link-card">
              <span>Tage bis {e.deName}</span>
              <span class="link-card__arrow">→</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── ULTIMATE GUIDE / E-E-A-T SECTION ───────────────────────────────── -->
  <article class="section semantic-guide" style="background-color: var(--clr-surf-1); border-top: 1px solid var(--clr-border);">
    <div class="container container--narrow">
      <div class="content-section">
        <h2>Präzise Zeiterfassung für Lohnabrechnung und Projektmanagement</h2>
        <div class="content-prose">
          <p>
            Eine exakte <strong>Zeiterfassung</strong> ist das Rückgrat effizienter Personalverwaltung und fairen Projektmanagements. 
            Egal ob Sie als Freelancer <em>fakturierbare Stunden (billable hours)</em> erfassen oder als HR-Verantwortlicher die 
            Einhaltung des Arbeitszeitgesetzes (ArbZG) überwachen: Unser Zeitrechner liefert auf die Minute genaue Ergebnisse für den Stundenzettel.
          </p>

          <h3>Industrieminuten vs. Zeitminuten (Dezimalstunden)</h3>
          <p>
            Für die Lohnbuchhaltung (Payroll) wird Arbeitszeit nicht im 60-Minuten-Takt, sondern in <strong>Dezimalstunden (Industrieminuten)</strong> 
            abgerechnet. Eine Arbeitszeitspanne von 8 Stunden und 45 Minuten entspricht exakt <code>8,75 Dezimalstunden</code>. 
            Der Zeitrechner konvertiert Bruttoarbeitszeiten nach Abzug der Pause automatisch in das korrekte Dezimalformat, 
            sodass Sie den Wert direkt mit dem Stundensatz multiplizieren können.
          </p>

          <h3>Sommerzeit (DST), Zeitzonen und Feiertage</h3>
          <p>
            Berechnungen über einen längeren Zeitraum müssen astronomische Hürden meistern. Der Calculator berücksichtigt 
            automatisch <strong>Schaltjahre</strong> und nutzt den lokalen Zeitzonen-Offset Ihres Browsers, um Verschiebungen durch 
            die <em>Sommerzeit (Daylight Saving Time - DST)</em> fehlerfrei zu kompensieren. 
          </p>
        </div>
      </div>

      <div class="content-section" style="margin-top: 40px;">
        <h2>Häufig gestellte Fragen (FAQ)</h2>
        <div class="faq-list" itemscope itemtype="https://schema.org/FAQPage">
          {homeFaqsDe.map(faq => (
            <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
              <button class="faq-item__question" aria-expanded="false" itemprop="name">
                {faq.q}
                <span class="faq-arrow" aria-hidden="true">▾</span>
              </button>
              <div class="faq-item__answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <span itemprop="text">{faq.a}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </article>

</BaseLayout>

<script>
// Live clock update — client-only, filled immediately then ticked every second
const liveTime = document.getElementById('live-time');
if (liveTime) {
  const tick = () => { liveTime.textContent = new Date().toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit', second: '2-digit' }); };
  tick();
  setInterval(tick, 1000);
}
</script>
