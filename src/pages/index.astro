---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModeTabbar from '../components/calculator/ModeTabbar';
import { buildWebAppSchema, buildBreadcrumbSchema, getHubUrl, getTimeRangeUrl, getWorkHoursUrl, getCountdownUrl, getGuideUrl, getFullUrl } from '../lib/seoEngine';
import { INDEXED_RANGES, formatHour24 } from '../data/timeRanges';
import { INDEXED_EVENTS } from '../data/dateEvents';
import { computeShiftFromHours } from '../lib/shift';

// Worked example figures — derived, never hardcoded (Phase 1.2)
const example = computeShiftFromHours(9, 17, 30, 'de'); // 09:00–17:00, 30 min break
const fullDay = computeShiftFromHours(0, 0, 0, 'de');    // full 24h cycle

const lang = 'de';
const canonical = getHubUrl(lang); // "/"
const altUrl = getHubUrl('en'); // "/en/"
const lastUpdated = new Date().toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });

const homeFaqsDe = [
  { q: 'Wie berechne ich die Zeit zwischen zwei Uhrzeiten?', a: 'Ziehen Sie die Startzeit von der Endzeit ab. Sind die Minuten der Startzeit größer, „leihen“ Sie sich 60 Minuten von der Stundenstelle. Beispiel: von 09:15 bis 17:45 Uhr sind es 8 Stunden und 30 Minuten. Liegt das Ende vor dem Start, läuft die Spanne über Mitternacht und Sie addieren 24 Stunden (22:00–06:00 = 8 Stunden). Der Zeitrechner übernimmt das automatisch.' },
  { q: 'Wie rechne ich Stunden und Minuten in Dezimalstunden (Industrieminuten) um?', a: 'Teilen Sie die Minuten durch 60 und addieren Sie das Ergebnis zu den vollen Stunden: Dezimalstunden = Stunden + (Minuten ÷ 60). 8 Stunden 15 Minuten sind also 8,25 Dezimalstunden. Industrieminuten sind streng genommen Hundertstel einer Stunde – 30 Minuten entsprechen 50 Industrieminuten (0,50 h). Die Lohnbuchhaltung nutzt diese Dezimalwerte, weil sie sich direkt mit dem Stundenlohn multiplizieren lassen.' },
  { q: 'Berücksichtigt der Zeitrechner Sommer- und Winterzeit (DST) und Schaltjahre?', a: 'Ja. Zeitdifferenzen und Countdowns greifen auf den lokalen Zeitzonen-Offset Ihres Browsers zurück und berechnen Schaltjahre sowie die Umstellung auf Sommer- und Winterzeit (DST) fehlerfrei – auch über Datumsgrenzen hinweg.' },
  { q: 'Muss die gesetzliche Pause abgezogen werden?', a: 'Für die Nettoarbeitszeit ja. Nach § 4 Arbeitszeitgesetz (ArbZG) sind bei mehr als 6 Stunden Arbeit mindestens 30 Minuten und bei mehr als 9 Stunden 45 Minuten unbezahlte Pause abzuziehen. Die Pause muss die Arbeit unterbrechen und darf nicht an Anfang oder Ende liegen. Im Rechner tragen Sie die Pausenzeit direkt ein.' },
  { q: 'Was ist der Unterschied zwischen Brutto- und Nettoarbeitszeit?', a: 'Die Bruttoarbeitszeit ist die gesamte Anwesenheit von Arbeitsbeginn bis Arbeitsende. Die Nettoarbeitszeit ergibt sich nach Abzug der unbezahlten Pausen und ist die Basis für den Lohn. Beispiel: 09:00–17:30 Uhr sind 8,5 Stunden brutto; mit 30 Minuten Pause bleiben 8,0 Stunden netto.' },
  { q: 'Ist der Zeitrechner kostenlos und ohne Anmeldung nutzbar?', a: 'Ja. Alle Rechner – Zeitdifferenz, Arbeitsstunden, Addieren/Subtrahieren und Countdown – sind kostenlos, ohne Registrierung und direkt im Browser nutzbar. Die Berechnung läuft lokal auf Ihrem Gerät; es werden keine Eingaben an einen Server gesendet.' }
];

const hreflang = [
  { lang: 'de', url: getFullUrl(canonical) },
  { lang: 'en', url: getFullUrl(altUrl) },
  { lang: 'x-default', url: getFullUrl(altUrl) },
];

const jsonLd = [
  buildWebAppSchema(lang),
  buildBreadcrumbSchema([
    { name: 'Startseite', url: canonical },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaqsDe.map(faq => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  }
];

// Popular ranges for links
const popularRanges = INDEXED_RANGES.filter(r => r.priority === 'high').slice(0, 9);
const popularEvents = INDEXED_EVENTS.filter(e => e.priority === 'high').slice(0, 6);

const currentTime = new Date().toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
---

<BaseLayout
  title={`Zeitrechner ${new Date().getFullYear()} — Stunden, Arbeitszeit & Countdown online`}
  description="Präziser Zeitrechner für 2026. Berechne Zeitdifferenzen, Arbeitsstunden mit Pausen und Live-Countdowns. Kostenlos & mobil-optimiert."
  canonical={getFullUrl(canonical)}
  hreflang={hreflang}
  lang={lang}
  jsonLd={jsonLd}
  theme="home"
>

  <!-- ─── HERO (centered, calculator-first) ──────────────────────────────── -->
  <section class="section landing-hero" style="padding-bottom: 2rem;">
    <div class="container">
      <div class="hero-centered">
        <div class="landing-hero__meta">
          <span class="badge badge--accent">Kostenlos</span>
          <span class="badge badge--violet">Deutsch</span>
          <span class="badge badge--green">DST-sicher</span>
        </div>

        <h1 style="margin-bottom: 1.25rem;">Zeitrechner — Stunden, Zeiten & Countdowns</h1>

        <p class="landing-hero__lead">
          Berechne Zeitdifferenzen, addiere Stunden, ermittle Nettoarbeitszeiten und zähle Tage bis zu wichtigen Ereignissen.
          <strong>5 Modi, sofortige Ergebnisse, keine Registrierung.</strong>
        </p>

        <!-- Calculator -->
        <div class="home-hero-calc calc-shell" id="differenz">
          <div class="glass glass--raised">
            <ModeTabbar client:visible lang="de" />
          </div>
        </div>

        <!-- Live time (client-only; no build-time value is baked into the HTML) -->
        <div class="live-chip">
          <span>Aktuelle Zeit:</span>
          <span id="live-time" aria-live="off"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FEATURED SNIPPETS ──────────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="stat-grid">
        <div class="stat-card">
          <span class="stat-card__value">{example.grossDecimal}h</span>
          <span class="stat-card__label">Stunden von 9 bis 17 Uhr</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">{example.netDecimalStr}h</span>
          <span class="stat-card__label">Netto (30 Min Pause)</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">{example.grossMin}</span>
          <span class="stat-card__label">Minuten Standardarbeitstag</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">{fullDay.grossDecimal}h</span>
          <span class="stat-card__label">Ein vollständiger Zyklus</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── POPULAR TIME RANGES ────────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0;" id="arbeit">
    <div class="container">
      <div class="internal-links" id="zeiten">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.4rem; margin: 0;">Beliebte Zeitspannen</h2>
        </div>
        <div class="link-grid">
          {popularRanges.map(r => (
            <a href={getTimeRangeUrl(lang, r.deSlug)} class="link-card">
              <span>Stunden zwischen {formatHour24(r.start)} und {formatHour24(r.end)}</span>
              <span class="link-card__arrow">→</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Arbeitsstunden Section -->
      <div class="internal-links" id="arbeitsstunden" style="margin-top: 32px;">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.4rem; margin: 0;">Arbeitsstunden-Rechner</h2>
        </div>
        <div class="link-grid">
          {INDEXED_RANGES.filter(r => r.workShift).map(r => (
            <a href={`${getTimeRangeUrl(lang, r.deSlug)}#arbeitszeit`} class="link-card">
              <span>Arbeitsstunden {formatHour24(r.start)} – {formatHour24(r.end)}</span>
              <span class="link-card__arrow">→</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Guides Section -->
      <section class="guides-section">
        <h3>Ratgeber & Ressourcen</h3>
        <div class="link-grid">
          <a href={getGuideUrl(lang, 'arbeitszeit-berechnen')} class="glass-card link-item">
            <span class="icon"></span>
            <div class="link-info">
              <span class="label">Arbeitszeit berechnen</span>
              <span class="sub">Der komplette Guide 2026</span>
            </div>
          </a>
          <a href={getGuideUrl(lang, 'zeiterfassung-freelancer')} class="glass-card link-item">
            <span class="icon"></span>
            <div class="link-info">
              <span class="label">Freelancer Zeiterfassung</span>
              <span class="sub">Tipps für produktive Arbeit</span>
            </div>
          </a>
        </div>
      </section>

      <!-- Internal Link Mesh -->
      <div class="internal-links" style="margin-top: 32px;" id="countdown">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.4rem; margin: 0;">Countdown-Timer</h2>
        </div>
        <div class="link-grid">
          {popularEvents.map(e => (
            <a href={getCountdownUrl(lang, e.deSlug)} class="link-card">
              <span>Tage bis {e.deName}</span>
              <span class="link-card__arrow">→</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── ULTIMATE GUIDE / E-E-A-T SECTION ───────────────────────────────── -->
  <article class="section semantic-guide" style="background-color: var(--clr-surf-1); border-top: 1px solid var(--clr-border);">
    <div class="container container--narrow">
      <div class="content-section">
        <h2>Zeit richtig berechnen: Dauer, Arbeitszeit und Countdown</h2>
        <div class="content-prose">
          <p>
            Eine exakte <strong>Zeitberechnung</strong> ist die Grundlage für faire Löhne, korrekte Rechnungen und verlässliche Planung.
            Ob Sie als Freelancer <em>fakturierbare Stunden</em> erfassen, als HR-Verantwortliche die Einhaltung des
            Arbeitszeitgesetzes (ArbZG) prüfen oder einfach die Tage bis zu einem Termin zählen: Der Zeitrechner liefert
            auf die Minute genaue Ergebnisse – kostenlos, ohne Anmeldung und direkt im Browser.
          </p>

          <h3>So berechnen Sie die Stunden zwischen zwei Uhrzeiten</h3>
          <p>
            Ziehen Sie die Startzeit von der Endzeit ab. Sind die Minuten der Startzeit größer als die der Endzeit, „leihen“
            Sie sich 60 Minuten von der Stundenstelle. Beispiel: von <strong>09:15 bis 17:45 Uhr</strong> sind es
            <code>8 Stunden 30 Minuten</code>. Endet die Schicht vor dem Start, läuft die Spanne über Mitternacht – dann
            zählen Sie einfach in den Folgetag weiter (22:00 bis 06:00 Uhr ergibt 8 Stunden). Diese <strong>Bruttozeit</strong>
            ist die reine Spanne, noch ohne Abzug von Pausen.
          </p>

          <h3>Brutto vs. Netto und die Umrechnung in Dezimalstunden</h3>
          <p>
            Die <strong>Nettoarbeitszeit</strong> ergibt sich, wenn Sie von der Bruttozeit die unbezahlten Pausen abziehen.
            Für die Lohnbuchhaltung wird sie nicht im 60-Minuten-Takt, sondern in <strong>Dezimalstunden</strong> abgerechnet:
            Dezimalstunden = Stunden + (Minuten ÷ 60). So sind 8 Stunden 45 Minuten exakt <code>8,75 Dezimalstunden</code>.
            <em>Industrieminuten</em> sind dabei Hundertstel einer Stunde – 30 echte Minuten entsprechen also 50 Industrieminuten (0,50 h),
            nicht 30. Der Rechner liefert Netto, Brutto und Dezimalwert in einem Schritt, damit Sie den Betrag direkt mit dem
            Stundensatz multiplizieren können.
          </p>

          <h3>Pausen, Ruhezeiten und Nachtarbeit nach dem ArbZG</h3>
          <p>
            Nach § 4 ArbZG sind bei mehr als 6 Stunden Arbeit mindestens 30 Minuten und bei mehr als 9 Stunden 45 Minuten Pause
            vorgeschrieben. Zwischen zwei Schichten gilt eine ununterbrochene <strong>Ruhezeit</strong> von 11 Stunden (§ 5 ArbZG),
            die werktägliche Höchstarbeitszeit liegt bei 8 Stunden – ausnahmsweise 10 Stunden mit Ausgleich (§ 3). Arbeit von mehr
            als 2 Stunden zwischen 23:00 und 6:00 Uhr gilt als <strong>Nachtarbeit</strong> und begründet Anspruch auf Zuschlag oder
            Freizeitausgleich (§ 6). Alle Berechnungen berücksichtigen zudem <strong>Schaltjahre</strong> und die
            Sommer-/Winterzeit-Umstellung (DST).
          </p>
        </div>
      </div>

      <div class="content-section" style="margin-top: 40px;">
        <h2>Häufig gestellte Fragen (FAQ)</h2>
        <div class="faq-list" itemscope itemtype="https://schema.org/FAQPage">
          {homeFaqsDe.map(faq => (
            <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
              <button class="faq-item__question" aria-expanded="false" itemprop="name">
                {faq.q}
                <span class="faq-arrow" aria-hidden="true">▾</span>
              </button>
              <div class="faq-item__answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <span itemprop="text">{faq.a}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </article>

</BaseLayout>

<script>
// Live clock update — client-only, filled immediately then ticked every second
const liveTime = document.getElementById('live-time');
if (liveTime) {
  const tick = () => { liveTime.textContent = new Date().toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit', second: '2-digit' }); };
  tick();
  setInterval(tick, 1000);
}
</script>
