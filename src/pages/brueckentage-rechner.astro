---
import BaseLayout from '../layouts/BaseLayout.astro';
import { computeBrueckentage, STATE_SLUGS } from '../lib/brueckentage';
import { getHolidays, BUNDESLAENDER } from '../lib/holidays';
import { getHubUrl, getFullUrl, buildBreadcrumbSchema, buildFAQSchema } from '../lib/seoEngine';

const lang = 'de';
const canonical = '/brueckentage-rechner/';

const thisYear = new Date().getFullYear();
const years = [thisYear, thisYear + 1, thisYear + 2];
const defaultYear = thisYear + 1;      // people plan the next full year

// Per-year overview: one summary row per Bundesland, sorted by free days gained.
const overview: Record<number, { code: string; name: string; slug: string; hc: number; u: number; f: number }[]> = {};
for (const y of years) {
  overview[y] = BUNDESLAENDER.map(b => {
    const r = computeBrueckentage(y, b.code);
    return { code: b.code, name: b.de, slug: STATE_SLUGS[b.code], hc: getHolidays(y, b.code).length, u: r.bestUrlaub, f: r.bestFree };
  }).sort((a, b) => b.f - a.f);
}
const defRows = overview[defaultYear];

const faqs = [
  { q: 'Was ist ein Brückentag?', a: 'Ein Brückentag ist ein Arbeitstag, der zwischen einem gesetzlichen Feiertag und dem Wochenende liegt. Nimmt man diesen einzelnen Tag frei, entsteht ein langes, zusammenhängendes freies Wochenende. Fällt ein Feiertag etwa auf einen Donnerstag, „überbrückt" der Freitag die Lücke zum Wochenende – aus einem Urlaubstag werden vier freie Tage.' },
  { q: 'Wie berechnet dieser Rechner die Brückentage?', a: 'Der Rechner ermittelt alle gesetzlichen Feiertage des gewählten Bundeslands – bewegliche Feiertage wie Christi Himmelfahrt werden aus dem Osterdatum berechnet, nicht nachgeschlagen. Anschließend sucht er die kurzen Arbeitstag-Lücken (1 bis 4 Tage) zwischen freien Blöcken und zeigt, wie viele freie Tage am Stück ein Urlaubstag jeweils bringt.' },
  { q: 'Warum unterscheiden sich die Brückentage je nach Bundesland?', a: 'Neben den neun bundesweiten Feiertagen hat jedes der 16 Bundesländer eigene. Fronleichnam ist zum Beispiel nur in Bayern, Baden-Württemberg, Hessen, NRW, Rheinland-Pfalz und dem Saarland ein Feiertag – dort ergibt sich eine zusätzliche Brücke. Deshalb ändert sich die Liste je nach Bundesland.' },
  { q: 'Was bedeutet die „Effizienz"?', a: 'Die Effizienz ist das Verhältnis von freien Tagen zu eingesetzten Urlaubstagen. Ein Feiertag am Donnerstag mit einem Brückentag am Freitag ergibt vier freie Tage für einen Urlaubstag – also den Faktor 4,0. Je höher der Wert, desto mehr Erholung pro Urlaubstag.' },
];

const jsonLd = [buildFAQSchema(faqs), buildBreadcrumbSchema([{ name: 'Startseite', url: getHubUrl(lang) }, { name: 'Brückentage-Rechner', url: canonical }])];
---
<BaseLayout
  title="Brückentage-Rechner — Urlaub optimal planen nach Bundesland"
  description="Brückentage berechnen für alle 16 Bundesländer: Vergleiche, wo du mit wenigen Urlaubstagen die meisten freien Tage gewinnst. Mit Detailseite je Bundesland und Jahr. Kostenlos."
  canonical={getFullUrl(canonical)}
  hreflang={[{ lang: 'de', url: getFullUrl(canonical) }, { lang: 'x-default', url: getFullUrl(canonical) }]}
  lang={lang}
  jsonLd={jsonLd}
  theme="info"
>
  <section class="section landing-hero" style="padding-bottom: 1.5rem;">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="breadcrumb__sep">›</span><span aria-current="page">Brückentage-Rechner</span></nav>
      <div style="margin-top: 1.5rem; max-width: 760px;">
        <span class="badge badge--green">Deutschland · alle 16 Bundesländer</span>
        <h1 style="margin: 0.5rem 0 0.75rem;">Brückentage-Rechner</h1>
        <p class="landing-hero__lead">Hol das Maximum aus deinem Urlaub: Wähle ein Jahr und vergleiche alle Bundesländer – oder öffne dein Bundesland für die vollständige Liste aller Brücken mit Datum und Effizienz.</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <div class="glass" style="padding: 1.25rem 1.5rem; border-radius: var(--radius);">
        <label class="field" style="max-width: 220px;"><span>Jahr</span>
          <select id="bt-year">{years.map(y => <option value={y} selected={y === defaultYear}>{y}</option>)}</select>
        </label>
        <p style="margin: 12px 0 0; color: var(--ink-3); font-size: 0.9rem;">Beste überschneidungsfreie Auswahl je Bundesland – sortiert nach den meisten freien Tagen. Für alle Brücken mit genauem Datum auf ein Bundesland klicken.</p>
      </div>

      <div style="overflow-x: auto; margin-top: 1.25rem;">
        <table class="bt-table" id="bt-overview">
          <thead>
            <tr><th>Bundesland</th><th style="text-align:center;">Feiertage</th><th style="text-align:center;">Urlaubstage</th><th style="text-align:center;">Freie Tage</th><th></th></tr>
          </thead>
          <tbody id="bt-obody">
            {defRows.map(r => (
              <tr>
                <td>{r.name}</td>
                <td style="text-align:center;">{r.hc}</td>
                <td style="text-align:center;">{r.u}</td>
                <td style="text-align:center;"><strong>{r.f}</strong></td>
                <td style="text-align:right;"><a class="bt-detail-link" href={`/brueckentage-${defaultYear}-${r.slug}/`}>Details →</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="content-section content-prose" style="margin-top: 2rem;">
        <div class="featured-snippet" role="complementary" aria-label="Kurzantwort" style="margin: 0 0 28px;">
          <div class="featured-snippet__label">Kurz & knapp</div>
          <p class="featured-snippet__sentence" style="margin: 8px 0 0;">
            <strong>Ein Brückentag ist ein Arbeitstag zwischen Feiertag und Wochenende.</strong> Nimmst du ihn frei,
            wird aus einem Urlaubstag ein langes Wochenende. Die Tabelle zeigt je Bundesland, wie viele freie Tage mit
            optimal gelegten Urlaubstagen möglich sind – die Detailseite listet jede einzelne Brücke mit Datum.
          </p>
        </div>

        <h2>So funktionieren Brückentage</h2>
        <p>
          Gesetzliche Feiertage fallen jedes Jahr auf einen anderen Wochentag. Liegt ein Feiertag auf einem
          <strong>Dienstag</strong>, brauchst du nur den Montag als Urlaub, um von Samstag bis Dienstag frei zu haben.
          Ein Feiertag am <strong>Donnerstag</strong> lässt sich mit dem Freitag zum langen Wochenende verbinden. Rund um
          Ostern und die Mai-Feiertage (Tag der Arbeit, Christi Himmelfahrt, Pfingsten) lassen sich mit wenigen
          Urlaubstagen besonders lange Auszeiten planen. Da jedes Bundesland eigene Feiertage hat, unterscheidet sich
          die Ausbeute – Bayern und Baden-Württemberg mit den meisten Feiertagen bieten in der Regel die meisten Brücken.
        </p>
      </div>

      <div class="internal-links" style="margin-top: 12px;">
        <div class="internal-links__header"><h2 class="internal-links__title" style="font-size: 1.2rem; margin: 0;">Passende Rechner & Ratgeber</h2></div>
        <div class="link-grid">
          <a href="/arbeitstage-rechner/" class="link-card"><span>Arbeitstage-Rechner (nach Bundesland)</span><span class="link-card__arrow">→</span></a>
          <a href="/ratgeber/urlaubstage-berechnen/" class="link-card"><span>Urlaubstage berechnen</span><span class="link-card__arrow">→</span></a>
          <a href="/datum-in-x-tagen/" class="link-card"><span>Datum in X Tagen berechnen</span><span class="link-card__arrow">→</span></a>
          <a href={getHubUrl(lang)} class="link-card"><span>Zum Zeitrechner</span><span class="link-card__arrow">→</span></a>
        </div>
      </div>

      <div class="content-section"><h2>Häufig gestellte Fragen</h2>
        <div class="faq-list" itemscope itemtype="https://schema.org/FAQPage">
          {faqs.map(f => (
            <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
              <button class="faq-item__question" aria-expanded="false" itemprop="name">{f.q}<span class="faq-arrow" aria-hidden="true">▾</span></button>
              <div class="faq-item__answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer"><span itemprop="text">{f.a}</span></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ OVERVIEW: overview }}>
    document.addEventListener('DOMContentLoaded', () => {
      const yearSel = document.getElementById('bt-year');
      const tbody = document.getElementById('bt-obody');
      function render() {
        const y = yearSel.value;
        const rows = OVERVIEW[y];
        if (!rows) return;
        tbody.innerHTML = rows.map(r =>
          '<tr><td>' + r.name + '</td>' +
          '<td style="text-align:center;">' + r.hc + '</td>' +
          '<td style="text-align:center;">' + r.u + '</td>' +
          '<td style="text-align:center;"><strong>' + r.f + '</strong></td>' +
          '<td style="text-align:right;"><a class="bt-detail-link" href="/brueckentage-' + y + '-' + r.slug + '/">Details →</a></td></tr>'
        ).join('');
      }
      yearSel.addEventListener('change', render);
      render();
    });
  </script>

  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <p class="legal-note">Hinweis: Dieser Rechner bietet eine allgemeine Orientierungshilfe zur Urlaubsplanung auf Basis der gesetzlichen Feiertage des gewählten Bundeslands. Ob und wann Urlaub genehmigt wird, richtet sich nach dem Arbeits- bzw. Tarifvertrag und den betrieblichen Regelungen.</p>
    </div>
  </section>
</BaseLayout>
