---
// /arbeitsstunden-[slug]/
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkHoursCalc from '../components/calculator/WorkHoursCalc';
import { ALL_TIME_RANGES, INDEXED_RANGES, formatHour24, getRangeHours, getSimilarRanges } from '../data/timeRanges';
import type { TimeRange } from '../data/timeRanges';
import { buildSEOMeta, buildFAQSchema, buildBreadcrumbSchema, getWorkHoursUrl, getTimeRangeUrl, getHubUrl, shouldIndex } from '../lib/seoEngine';
import { workHoursIntros_de, faqSets_de, variantIndex } from '../data/contentVariants';
import { calcWorkHours } from '../lib/timeEngine';

export async function getStaticPaths() {
  const paths = [];
  for (const range of ALL_TIME_RANGES) {
    // Add primary German slug
    paths.push({ params: { slug: range.deSlug }, props: { range } });
    // Add English slug for redirection/robustness
    if (range.slug !== range.deSlug) {
      paths.push({ params: { slug: range.slug }, props: { range } });
    }
  }
  return paths;
}

interface Props { range: TimeRange; }
const { range } = Astro.props as Props;
const { slug } = Astro.params;

// 301 Redirect to German slug if English slug is used on a German page
if (slug === range.slug && range.slug !== range.deSlug) {
  return Astro.redirect(getWorkHoursUrl('de', range.deSlug), 301);
}

const lang = 'de';
const hours = getRangeHours(range.start, range.end);
const start24 = formatHour24(range.start);
const end24 = formatHour24(range.end);

// Pre-calculate with common breaks
const BREAK_OPTIONS = [0, 30, 45, 60];
const breakResults = BREAK_OPTIONS.map(b => ({
  break: b,
  result: calcWorkHours(`${String(range.start).padStart(2,'0')}:00`, `${String(range.end).padStart(2,'0')}:00`, b),
}));

const canonical = getWorkHoursUrl(lang, range.deSlug);
const altUrl = getWorkHoursUrl('en', range.slug);

const hreflang = [
  { lang: 'de', url: canonical },
  { lang: 'en', url: altUrl },
  { lang: 'x-default', url: altUrl },
];

const vi = variantIndex(range.deSlug + 'work', workHoursIntros_de.length);
const introHtml = workHoursIntros_de[vi](start24, end24, breakResults[1].result.netHours);

const fi = variantIndex(range.deSlug + 'wfaq', faqSets_de.length);
const faqs = faqSets_de[fi](start24, end24, hours);

const similarRanges = getSimilarRanges(range, 6);

const isIndexed = shouldIndex('work-hours', range.demandScore) || range.workShift;

const seoMeta = buildSEOMeta(
  'work-hours', lang,
  { start: start24, end: end24, net: breakResults[1].result.netDecimal },
  canonical, 'en', altUrl,
  !isIndexed
);

const jsonLd = [
  buildFAQSchema(faqs),
  buildBreadcrumbSchema([
    { name: 'Startseite', url: getHubUrl(lang) },
    { name: `Arbeitsstunden ${start24}–${end24}`, url: canonical },
  ]),
];

const lastUpdated = new Date().toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={seoMeta.title}
  description={seoMeta.description}
  canonical={seoMeta.canonical}
  hreflang={seoMeta.hreflang}
  lang={lang}
  jsonLd={jsonLd}
  ogImage={seoMeta.ogImage}
  ogImageAlt={seoMeta.ogImageAlt}
  theme="work-hours"
>

  <section class="section landing-hero" style="padding-bottom: 2rem;">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">›</span>
        <span aria-current="page">Arbeitsstunden {start24}–{end24}</span>
      </nav>

      <div class="dashboard-grid" style="margin-top: 1.5rem; align-items: center;">
        <!-- Left: Payroll Comparison Card -->
        <div>
          <div class="payroll-sheet">
            <h3 style="margin-top: 0; margin-bottom: 20px; font-size: 1.1rem; display: flex; align-items: center; gap: 8px; color: var(--clr-text);">
              📊 Nettoarbeitszeit-Vergleich
            </h3>
            {breakResults.map(br => {
              const pct = hours > 0 ? (br.result.netDecimal / hours) * 100 : 0;
              return (
                <div class="payroll-row">
                  <div class="payroll-info">
                    <span class="payroll-label">
                      {br.break === 0 ? 'Ohne Pause' : `${br.break} Min. Pause`}
                    </span>
                    <span class="payroll-val">{br.result.formatted} ({br.result.netDecimal}h)</span>
                  </div>
                  <div class="payroll-bar-track">
                    <div class="payroll-bar-fill" style={`width: ${pct}%`} />
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Right: Text & Featured Snippet -->
        <div>
          <div class="landing-hero__meta" style="margin-bottom: 1rem;">
            <span class="badge badge--green">💼 Arbeitsstunden</span>
            <span class="badge badge--accent">Schicht {hours}h</span>
            <span class="last-updated">Zuletzt aktualisiert: {lastUpdated}</span>
          </div>

          <h1 style="font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 1.5rem; line-height: 1.3;">
            Arbeitsstunden {start24} bis {end24} Uhr berechnen
          </h1>

          <div class="featured-snippet" role="complementary" aria-label="Schnellantwort" style="margin: 0;">
            <div class="featured-snippet__label">Schnellantwort</div>
            <div class="featured-snippet__answer">{breakResults[1].result.formatted} netto</div>
            <p class="featured-snippet__sentence" style="margin-top: var(--space-2); margin-bottom: 0;">
              Von {start24} bis {end24} Uhr mit 30 Minuten Pause sind es <strong>{breakResults[1].result.netDecimal} Stunden</strong> Nettoarbeitszeit.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Prose and legal warning -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="dashboard-grid" style="align-items: start;">
        <!-- Left: Prose Content -->
        <div class="content-prose">
          <p set:html={introHtml} />
          <br />
          <p>
            Für Lohnabrechnungszwecke ist die Dezimaldarstellung wichtig: <strong>{breakResults[1].result.netDecimal} Stunden</strong>
            lassen sich direkt mit dem Stundensatz multiplizieren. Bei {breakResults[2].result.netDecimal} Stunden (45 Min Pause)
            oder {breakResults[3].result.netDecimal} Stunden (60 Min Pause) ändert sich die Bruttoarbeitszeit entsprechend.
          </p>
        </div>

        <!-- Right: Sticky Expert Box -->
        <div>
          <div class="glass glass--accent expert-box" style="position: sticky; top: 96px; padding: 24px; border-radius: 12px;">
            <h3 style="margin-top: 0; margin-bottom: 12px; font-size: 1.1rem; display: flex; align-items: center; gap: 8px;">
              ⚖️ Gesetzliche Pausenregelung (ArbZG)
            </h3>
            <p style="font-size: 0.9rem; margin-bottom: 12px; color: var(--clr-text-2);">
              In Deutschland schreibt das <strong>Arbeitszeitgesetz (ArbZG)</strong> zwingend Pausen vor:
            </p>
            <ul style="margin-bottom: 12px; padding-left: 20px; font-size: 0.85rem; color: var(--clr-text-2); display: flex; flex-direction: column; gap: 6px;">
              <li><strong>Ab 6 Stunden Arbeit:</strong> Mindestens 30 Minuten Pause.</li>
              <li><strong>Ab 9 Stunden Arbeit:</strong> Mindestens 45 Minuten Pause.</li>
              <li>Die Pause muss die Arbeitszeit unterbrechen und darf nicht am Anfang oder Ende liegen.</li>
            </ul>
            <p style="margin-top: 15px; margin-bottom: 0; font-size: 0.8rem; color: var(--clr-text-3);">
              <em>Hinweis: Unser Rechner hilft Ihnen bei der korrekten Netto-Erfassung für Ihren Stundenzettel.</em>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <div class="embedded-calc">
        <div class="embedded-calc__header">
          <div class="embedded-calc__title">Arbeitsstunden Rechner</div>
          <div class="embedded-calc__subtitle">Passe Pause und Zeiten für deine Schicht an</div>
        </div>
        <WorkHoursCalc client:visible lang="de"
          defaultStart={`${String(range.start).padStart(2,'0')}:00`}
          defaultEnd={`${String(range.end).padStart(2,'0')}:00`}
          defaultBreak={30}
        />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <h2 style="margin-bottom: 20px;">Häufig gestellte Fragen</h2>
      <div class="faq-list">
        {faqs.map(faq => (
          <div class="faq-item">
            <button class="faq-item__question" aria-expanded="false">
              {faq.q}
              <span class="faq-arrow">▾</span>
            </button>
            <div class="faq-item__answer">{faq.a}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="internal-links">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.2rem; margin: 0;">🔗 Ähnliche Schichten</h2>
        </div>
        <div class="link-grid">
          {similarRanges.map(r => (
            <a href={getWorkHoursUrl(lang, r.deSlug)} class="link-card">
              <span>Arbeitsstunden {formatHour24(r.start)}–{formatHour24(r.end)}</span>
              <span class="link-card__arrow">→</span>
            </a>
          ))}
          <a href={getTimeRangeUrl(lang, range.deSlug)} class="link-card">
            <span>Stunden zwischen {start24} und {end24}</span>
            <span class="link-card__arrow">→</span>
          </a>
          <a href={getHubUrl(lang)} class="link-card">
            <span>← Zum Zeitrechner</span>
            <span class="link-card__arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
