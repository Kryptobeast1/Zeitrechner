---
// /de/tage-bis-[slug]/
import BaseLayout from '../../layouts/BaseLayout.astro';
import CountdownCalc from '../../components/calculator/CountdownCalc';
import { INDEXED_EVENTS, getDaysUntil } from '../../data/dateEvents';
import type { DateEvent } from '../../data/dateEvents';
import { buildSEOMeta, buildFAQSchema, buildBreadcrumbSchema, getCountdownUrl, getHubUrl } from '../../lib/seoEngine';
import { countdownIntros_de, variantIndex } from '../../data/contentVariants';

export async function getStaticPaths() {
  return INDEXED_EVENTS.map(event => ({
    params: { slug: event.deSlug },
    props: { event },
  }));
}

interface Props { event: DateEvent; }
const { event } = Astro.props as Props;

const lang = 'de';
const days = Math.max(0, getDaysUntil(event.targetDate));
const canonical = getCountdownUrl(lang, event.deSlug);
const altUrl = getCountdownUrl('en', event.slug);

const hreflang = [
  { lang: 'de', url: canonical },
  { lang: 'en', url: altUrl },
  { lang: 'x-default', url: altUrl },
];

const vi = variantIndex(event.deSlug, countdownIntros_de.length);
const introHtml = countdownIntros_de[vi](event.deName, days);

const seoMeta = buildSEOMeta(
  'countdown', lang,
  { name: event.deName, days: days.toString() },
  canonical, 'en', altUrl,
);

const faqs = [
  { q: `Wie viele Stunden bis ${event.deName}?`, a: `Es sind noch ${days * 24} Stunden bis ${event.deName} (${event.targetDate}).` },
  { q: `Wie viele Minuten bis ${event.deName}?`, a: `Noch ${(days * 24 * 60).toLocaleString('de-DE')} Minuten bis ${event.deName}.` },
  { q: `Was ist das genaue Datum von ${event.deName}?`, a: `${event.deName} fällt auf den ${new Date(event.targetDate).toLocaleDateString('de-DE', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}.` },
];

const jsonLd = [
  buildFAQSchema(faqs),
  buildBreadcrumbSchema([
    { name: 'Startseite', url: 'https://zeitrechner.app/' },
    { name: 'Zeitrechner', url: getHubUrl(lang) },
    { name: `Tage bis ${event.deName}`, url: canonical },
  ]),
];

// Related events
const relatedEvents = INDEXED_EVENTS.filter(e => e.deSlug !== event.deSlug && e.category === event.category).slice(0, 6);

const lastUpdated = new Date().toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={seoMeta.title}
  description={seoMeta.description}
  canonical={canonical}
  hreflang={hreflang}
  lang={lang}
  jsonLd={jsonLd}
>

  <section class="section landing-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">›</span>
        <a href={getHubUrl(lang)}>Zeitrechner</a>
        <span class="breadcrumb__sep">›</span>
        <span aria-current="page">Tage bis {event.deName}</span>
      </nav>

      <div class="landing-hero__meta">
        <span class="badge badge--violet">⏳ Countdown</span>
        <span class="badge badge--accent">{days} Tage</span>
        <span class="last-updated">Live aktualisiert: {lastUpdated}</span>
      </div>

      <h1>Wie viele Tage bis {event.deName}?</h1>

      <div class="featured-snippet">
        <div class="featured-snippet__label">Schnellantwort</div>
        <div class="featured-snippet__answer">{days} Tage</div>
        <p class="featured-snippet__sentence" set:html={introHtml} />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="stat-grid">
        <div class="stat-card">
          <span class="stat-card__value">{days}</span>
          <span class="stat-card__label">Tage</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">{(days * 24).toLocaleString('de-DE')}</span>
          <span class="stat-card__label">Stunden</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">{Math.floor(days / 7)}</span>
          <span class="stat-card__label">Wochen</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">{new Date(event.targetDate).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit' })}</span>
          <span class="stat-card__label">Datum</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Live countdown -->
  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <div class="embedded-calc">
        <div class="embedded-calc__header">
          <div class="embedded-calc__title">Live-Countdown bis {event.deName}</div>
          <div class="embedded-calc__subtitle">Aktualisiert jede Sekunde</div>
        </div>
        <CountdownCalc client:load lang="de"
          defaultTarget={event.targetDate}
          eventName={event.deName}
        />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <h2 style="margin-bottom: 20px;">Häufig gestellte Fragen</h2>
      <div class="faq-list">
        {faqs.map(faq => (
          <div class="faq-item">
            <button class="faq-item__question" aria-expanded="false">
              {faq.q}
              <span class="faq-arrow">▾</span>
            </button>
            <div class="faq-item__answer">{faq.a}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {relatedEvents.length > 0 && (
    <section class="section" style="padding-top: 0;">
      <div class="container">
        <div class="internal-links">
          <div class="internal-links__header">
            <h2 class="internal-links__title" style="font-size: 1.2rem; margin: 0;">⏳ Ähnliche Countdowns</h2>
          </div>
          <div class="link-grid">
            {relatedEvents.map(e => {
              const d = getDaysUntil(e.targetDate);
              return (
                <a href={getCountdownUrl(lang, e.deSlug)} class="link-card">
                  <span>Tage bis {e.deName} ({d} Tage)</span>
                  <span class="link-card__arrow">→</span>
                </a>
              );
            })}
            <a href={getHubUrl(lang)} class="link-card">
              <span>← Zurück zum Zeitrechner</span>
              <span class="link-card__arrow">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

</BaseLayout>
