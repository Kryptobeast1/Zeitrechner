---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHubUrl, getFullUrl, buildBreadcrumbSchema } from '../lib/seoEngine';
import { formatDecimal } from '../lib/shift';
const lang = 'de';
const canonical = '/tarifmodelle/';

const models = [
  { name: 'TVöD (öffentlicher Dienst)', weekly: 39 },
  { name: 'IG Metall (Tarif West)', weekly: 35 },
  { name: 'Standard-Vollzeit', weekly: 40 },
];
const dec = (n: number) => formatDecimal(n, 'de');
const jsonLd = [buildBreadcrumbSchema([{ name: 'Startseite', url: getHubUrl(lang) }, { name: 'Tarif-Wochenmodelle', url: canonical }])];
---
<BaseLayout title="Tarif-Wochenmodelle im Vergleich — TVöD 39h, IG Metall 35h, 40h" description="Vergleich der gängigen Wochenarbeitszeit-Modelle: TVöD 39 Stunden, IG Metall 35 Stunden und Standard-Vollzeit 40 Stunden — mit Tages-, Monats- und Jahreswerten." canonical={getFullUrl(canonical)} hreflang={[{ lang: 'de', url: getFullUrl(canonical) }, { lang: 'x-default', url: getFullUrl(canonical) }]} lang={lang} jsonLd={jsonLd} theme="info">
  <section class="section landing-hero" style="padding-bottom: 1.5rem;">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="breadcrumb__sep">›</span><span aria-current="page">Tarif-Wochenmodelle</span></nav>
      <div style="margin-top: 1.5rem; max-width: 760px;">
        <h1 style="margin-bottom: 0.75rem;">Tarif-Wochenmodelle im Vergleich</h1>
        <p class="landing-hero__lead">Wie viel bedeutet eine 35-, 39- oder 40-Stunden-Woche pro Tag, Monat und Jahr? Werte auf Basis einer 5-Tage-Woche (Monat = 4,33 Wochen).</p>
      </div>
    </div>
  </section>
  <section class="section" style="padding-top: 0;"><div class="container container--narrow">
    <div style="overflow-x:auto;"><table class="tarif-table">
      <thead><tr><th>Modell</th><th>Woche</th><th>Tag (5-Tage)</th><th>Monat (ø)</th><th>Jahr</th></tr></thead>
      <tbody>
        {models.map(m => (
          <tr>
            <td>{m.name}</td>
            <td class="tabular">{dec(m.weekly)} Std</td>
            <td class="tabular">{dec(m.weekly / 5)} Std</td>
            <td class="tabular">{dec(m.weekly * 4.33)} Std</td>
            <td class="tabular">{dec(m.weekly * 52)} Std</td>
          </tr>
        ))}
      </tbody>
    </table></div>
    <div class="content-section" style="margin-top: 2rem;">
      <p style="color: var(--ink-2);">Die tatsächliche tarifliche Wochenarbeitszeit variiert je nach Tarifgebiet, Entgeltgruppe und Betriebsvereinbarung. Diese Tabelle dient der schnellen Orientierung; verbindlich ist stets der jeweils geltende Tarifvertrag.</p>
    </div>
  </div></section>
</BaseLayout>
