---
import { INDEXED_RANGES } from '../data/timeRanges';
import { ALL_EVENTS } from '../data/dateEvents';
import { getHubUrl, getTimeRangeUrl, getWorkHoursUrl, getCountdownUrl, shouldIndex } from '../lib/seoEngine';

const languages = ['de', 'en'] as const;

// Collect all indexable URLs
const urls: string[] = [];

// Hubs
languages.forEach(lang => urls.push(getHubUrl(lang)));

// Time Ranges
INDEXED_RANGES.filter(r => shouldIndex('time-range', r.demandScore)).forEach(range => {
  languages.forEach(lang => {
    urls.push(getTimeRangeUrl(lang, range.slug));
  });
});

// Work Hours
INDEXED_RANGES.filter(r => shouldIndex('work-hours', r.demandScore) || r.workShift).forEach(range => {
  languages.forEach(lang => {
    urls.push(getWorkHoursUrl(lang, range.slug));
  });
});

// Countdowns
ALL_EVENTS.filter(e => e.priority !== 'low' || parseInt(e.targetDate.split('-')[0]) <= 2027).forEach(event => {
  languages.forEach(lang => {
    urls.push(getCountdownUrl(lang, event.slug));
  });
});

// Guides
urls.push('https://zeitrechner.app/de/ratgeber/arbeitszeit-berechnen/');
urls.push('https://zeitrechner.app/en/guides/how-to-calculate-work-hours/');
urls.push('https://zeitrechner.app/de/ratgeber/zeiterfassung-freelancer/');
urls.push('https://zeitrechner.app/en/guides/tracking-time-freelancers/');

const sitemap = `<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  ${urls.map(url => `
    <url>
      <loc>${url}</loc>
      <changefreq>weekly</changefreq>
      <priority>${url.includes('/de/zeitrechner/') || url.includes('/en/time-calculator/') ? '1.0' : '0.7'}</priority>
    </url>
  `).join('')}
</urlset>`.trim();

// Set correct header for XML
Astro.response.headers.set('Content-Type', 'application/xml');
---
<Fragment set:html={sitemap} />
