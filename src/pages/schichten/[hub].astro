---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HUBS, hubRanges } from '../../lib/hubs';
import { formatHour24, getRangeHours } from '../../data/timeRanges';
import { getHubUrl, getTimeRangeUrl, getFullUrl, buildBreadcrumbSchema } from '../../lib/seoEngine';

export async function getStaticPaths() {
  return HUBS.map(hub => ({ params: { hub: hub.slug }, props: { hub } }));
}
const { hub } = Astro.props;
const lang = 'de';
const ranges = hubRanges(hub);
const canonical = `/schichten/${hub.slug}/`;
const enHub = `/en/shifts/${hub.slug}/`;

const jsonLd = [buildBreadcrumbSchema([
  { name: 'Startseite', url: getHubUrl(lang) },
  { name: 'Beliebte Zeiten', url: '/alle-rechner/' },
  { name: hub.deTitle, url: canonical },
])];
---
<BaseLayout
  title={`${hub.deTitle} berechnen — Zeit-Rechner`}
  description={hub.deDesc}
  canonical={getFullUrl(canonical)}
  hreflang={[{ lang: 'de', url: getFullUrl(canonical) }, { lang: 'en', url: getFullUrl(enHub) }, { lang: 'x-default', url: getFullUrl(canonical) }]}
  lang={lang}
  jsonLd={jsonLd}
  theme="info"
  langAlternates={{ de: canonical, en: enHub }}
>
  <section class="section landing-hero" style="padding-bottom: 1.5rem;">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">›</span>
        <a href="/alle-rechner/">Beliebte Zeiten</a>
        <span class="breadcrumb__sep">›</span>
        <span aria-current="page">{hub.deTitle}</span>
      </nav>
      <div style="margin-top: 1.5rem; max-width: 760px;">
        <h1 style="margin-bottom: 0.75rem;">{hub.deTitle}</h1>
        <p class="landing-hero__lead">{hub.deDesc} <strong>{ranges.length} Rechner.</strong></p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="link-grid">
        {ranges.map(r => (
          <a href={getTimeRangeUrl(lang, r.deSlug)} class="link-card">
            <span>{formatHour24(r.start)}–{formatHour24(r.end)} Uhr ({getRangeHours(r.start, r.end)} Std)</span>
            <span class="link-card__arrow">→</span>
          </a>
        ))}
      </div>
      <p style="margin-top: 2rem;"><a href="/alle-rechner/">← Alle Kategorien</a></p>
    </div>
  </section>
</BaseLayout>
