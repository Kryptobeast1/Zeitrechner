---
import BaseLayout from '../layouts/BaseLayout.astro';
import { HUBS, hubRanges } from '../lib/hubs';
import { INDEXED_EVENTS } from '../data/dateEvents';
import { buildSEOMeta, getHubUrl, getCountdownUrl, getFullUrl } from '../lib/seoEngine';

const lang = 'de';
const title = 'Alle Rechner & Kategorien — Zeit-Rechner.com';
const description = 'Übersicht der Zeit- und Arbeitsstunden-Rechner nach Kategorie: Frühschichten, 8-Stunden-Schichten, Nachtschichten, Teilzeit und Countdowns.';
const canonical = '/alle-rechner/';
const seo = buildSEOMeta('hub', lang, {}, canonical, 'en', '/en/all-calculators/', false);
seo.title = title; seo.description = description;

const currentYear = new Date().getFullYear();
const countdowns = INDEXED_EVENTS
  .filter(e => parseInt(e.targetDate.split('-')[0], 10) >= currentYear)
  .slice(0, 24);
---
<BaseLayout title={seo.title} description={seo.description} canonical={getFullUrl(canonical)} hreflang={seo.hreflang} lang={lang} theme="info" langAlternates={{ de: canonical, en: '/en/all-calculators/' }}>
  <section class="section landing-hero" style="padding-bottom: 1.5rem;">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={getHubUrl(lang)}>Home</a>
        <span class="breadcrumb__sep">›</span>
        <span aria-current="page">Alle Rechner</span>
      </nav>
      <div style="margin-top: 1.5rem; max-width: 760px;">
        <h1 style="margin-bottom: 0.75rem;">Alle Rechner & Kategorien</h1>
        <p class="landing-hero__lead">{description}</p>
      </div>
    </div>
  </section>

  <!-- Tiered hubs — each is an independently rankable page of 20–40 links -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <h2 style="font-size: 1.3rem; margin-bottom: 1rem;">Schicht-Kategorien</h2>
      <div class="link-grid">
        {HUBS.map(hub => (
          <a href={`/schichten/${hub.slug}/`} class="link-card">
            <span><strong>{hub.deTitle}</strong> · {hubRanges(hub).length} Rechner</span>
            <span class="link-card__arrow">→</span>
          </a>
        ))}
      </div>

      <h2 style="font-size: 1.3rem; margin: 2rem 0 1rem;">Countdowns</h2>
      <div class="link-grid">
        {countdowns.map(e => (
          <a href={getCountdownUrl(lang, e.deSlug)} class="link-card">
            <span>Tage bis {e.deName}</span>
            <span class="link-card__arrow">→</span>
          </a>
        ))}
      </div>

      <h2 style="font-size: 1.3rem; margin: 2rem 0 1rem;">Ratgeber</h2>
      <div class="link-grid">
        <a href="/ratgeber/" class="link-card"><span>Alle Ratgeber-Artikel</span><span class="link-card__arrow">→</span></a>
        <a href="/wochenarbeitszeit/" class="link-card"><span>Wochenarbeitszeit</span><span class="link-card__arrow">→</span></a>
        <a href="/datum-in-x-tagen/" class="link-card"><span>Datum in X Tagen</span><span class="link-card__arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
