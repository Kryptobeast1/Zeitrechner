---
import BaseLayout from '../layouts/BaseLayout.astro';
import { INDEXED_RANGES, formatHour24 } from '../data/timeRanges';
import { ALL_EVENTS } from '../data/dateEvents';
import { buildSEOMeta, getHubUrl, getTimeRangeUrl, getWorkHoursUrl, getCountdownUrl, shouldIndex } from '../lib/seoEngine';

const lang = 'de';
const title = 'Alle Zeitrechner & Kombinationen (HTML Sitemap) — Zeit-Rechner.com';
const description = 'Übersicht aller Zeitrechner, Arbeitsstundenrechner und Countdown-Timer auf Zeit-Rechner.com. Finden Sie schnell das passende Tool.';
const canonical = '/alle-rechner/';

const seo = buildSEOMeta(
  'hub', lang,
  {},
  canonical, 'en', '/en/all-calculators/',
  false
);

seo.title = title;
seo.description = description;

const timeRanges = INDEXED_RANGES.filter(r => shouldIndex('time-range', r.demandScore));
const workRanges = INDEXED_RANGES.filter(r => shouldIndex('work-hours', r.demandScore) || r.workShift);
const countdowns = ALL_EVENTS.filter(e => e.priority !== 'low' || parseInt(e.targetDate.split('-')[0]) <= 2027);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  hreflang={seo.hreflang}
  lang={lang}
  theme="info"
>
  <section class="section landing-hero" style="padding-bottom: 2rem;">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">›</span>
        <span aria-current="page">Alle Rechner</span>
      </nav>

      <div style="margin-top: 1.5rem;">
        <span class="badge badge--accent">Sitemap</span>
        <h1 style="margin-top: var(--space-2); margin-bottom: var(--space-4);">Alle Rechner & Kombinationen</h1>
        <p class="landing-hero__lead" style="max-width: var(--max-width-content);">{description}</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      
      <!-- Tabs -->
      <div class="directory-tabs">
        <button class="directory-tab-btn active" data-tab="work">Arbeitsstunden</button>
        <button class="directory-tab-btn" data-tab="time">Zeitdifferenzen</button>
        <button class="directory-tab-btn" data-tab="countdown">Countdowns</button>
      </div>

      <!-- Tab Content: Work Hours -->
      <div class="directory-section animate-in" id="tab-work">
        <div class="directory-column-grid">
          {workRanges.map(r => (
            <a href={`${getTimeRangeUrl(lang, r.deSlug)}#arbeitszeit`} class="directory-link-item">
              💼 Arbeitszeit von {formatHour24(r.start)} bis {formatHour24(r.end)} Uhr
            </a>
          ))}
        </div>
      </div>

      <!-- Tab Content: Time Range -->
      <div class="directory-section animate-in" id="tab-time" style="display: none;">
        <div class="directory-column-grid">
          {timeRanges.map(r => (
            <a href={getTimeRangeUrl(lang, r.deSlug)} class="directory-link-item">
              ⏱️ Stunden zwischen {formatHour24(r.start)} und {formatHour24(r.end)} Uhr
            </a>
          ))}
        </div>
      </div>

      <!-- Tab Content: Countdown -->
      <div class="directory-section animate-in" id="tab-countdown" style="display: none;">
        <div class="directory-column-grid">
          {countdowns.map(e => (
            <a href={getCountdownUrl(lang, e.deSlug)} class="directory-link-item">
              ⏳ Tage bis {e.deName}
            </a>
          ))}
        </div>
      </div>

      <!-- Vanilla JS Tab Swapping -->
      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          const buttons = document.querySelectorAll('.directory-tab-btn');
          const sections = document.querySelectorAll('.directory-section');
          buttons.forEach(btn => {
            btn.addEventListener('click', () => {
              buttons.forEach(b => b.classList.remove('active'));
              sections.forEach(s => s.style.display = 'none');
              
              btn.classList.add('active');
              const tabId = 'tab-' + btn.getAttribute('data-tab');
              const activeSection = document.getElementById(tabId);
              if (activeSection) {
                activeSection.style.display = 'block';
              }
            });
          });
        });
      </script>

    </div>
  </section>
</BaseLayout>
