---
// /en/work-hours-[slug]/
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkHoursCalc from '../../components/calculator/WorkHoursCalc';
import { INDEXED_RANGES, formatHour24, getRangeHours, getSimilarRanges } from '../../data/timeRanges';
import type { TimeRange } from '../../data/timeRanges';
import { buildSEOMeta, buildFAQSchema, buildBreadcrumbSchema, getWorkHoursUrl, getTimeRangeUrl, getHubUrl } from '../../lib/seoEngine';
import { workHoursIntros_en, faqSets_en, variantIndex } from '../../data/contentVariants';
import { calcWorkHours } from '../../lib/timeEngine';

export async function getStaticPaths() {
  const workRanges = INDEXED_RANGES.filter(r => r.workShift);
  return workRanges.map(range => ({
    params: { slug: range.slug },
    props: { range },
  }));
}

interface Props { range: TimeRange; }
const { range } = Astro.props as Props;

const lang = 'en';
const hours = getRangeHours(range.start, range.end);
const start24 = formatHour24(range.start);
const end24 = formatHour24(range.end);

const BREAK_OPTIONS = [0, 30, 45, 60];
const breakResults = BREAK_OPTIONS.map(b => ({
  break: b,
  result: calcWorkHours(`${String(range.start).padStart(2,'0')}:00`, `${String(range.end).padStart(2,'0')}:00`, b),
}));

const canonical = getWorkHoursUrl(lang, range.slug);
const altUrl = getWorkHoursUrl('de', range.deSlug);

const hreflang = [
  { lang: 'en', url: canonical },
  { lang: 'de', url: altUrl },
  { lang: 'x-default', url: canonical },
];

const vi = variantIndex(range.slug + 'work', workHoursIntros_en.length);
const introHtml = workHoursIntros_en[vi](start24, end24, breakResults[1].result.netHours);

const fi = variantIndex(range.slug + 'wfaq', faqSets_en.length);
const faqs = faqSets_en[fi](start24, end24, hours);
const similarRanges = getSimilarRanges(range, 6);

const seoMeta = buildSEOMeta(
  'work-hours', lang,
  { start: start24, end: end24, net: breakResults[1].result.netDecimal },
  canonical, 'de', altUrl,
);

const jsonLd = [
  buildFAQSchema(faqs),
  buildBreadcrumbSchema([
    { name: 'Home', url: 'https://zeitrechner.app/' },
    { name: 'Time Calculator', url: getHubUrl(lang) },
    { name: `Work Hours ${start24}–${end24}`, url: canonical },
  ]),
];

const lastUpdated = new Date().toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={seoMeta.title}
  description={seoMeta.description}
  canonical={canonical}
  hreflang={hreflang}
  lang={lang}
  jsonLd={jsonLd}
>

  <section class="section landing-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">›</span>
        <a href={getHubUrl(lang)}>Time Calculator</a>
        <span class="breadcrumb__sep">›</span>
        <span aria-current="page">Work Hours {start24}–{end24}</span>
      </nav>

      <div class="landing-hero__meta">
        <span class="badge badge--green">💼 Work Hours</span>
        <span class="badge badge--accent">{hours}h Shift</span>
        <span class="last-updated">Last updated: {lastUpdated}</span>
      </div>

      <h1>Work Hours {start24} to {end24} — Net Time Calculator</h1>

      <div class="featured-snippet">
        <div class="featured-snippet__label">Quick Answer</div>
        <div class="featured-snippet__answer">{breakResults[1].result.formatted} net</div>
        <p class="featured-snippet__sentence">
          Working from {start24} to {end24} with a 30-minute break gives you <strong>{breakResults[1].result.netDecimal} net hours</strong>.
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <h2 style="margin-bottom: 20px;">Net Hours by Break Duration</h2>
      <div class="stat-grid">
        {breakResults.map(br => (
          <div class="stat-card">
            <span class="stat-card__value">{br.result.formatted}</span>
            <span class="stat-card__label">{br.break === 0 ? 'No break' : `${br.break} min break`}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <div class="content-prose">
        <p set:html={introHtml} />
        <p>
          For payroll purposes, the decimal format matters: {breakResults[1].result.netDecimal} hours
          can be multiplied directly by your hourly rate. With a 45-minute break you get {breakResults[2].result.netDecimal} hours,
          and with a full hour's break, {breakResults[3].result.netDecimal} net hours.
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <div class="embedded-calc">
        <div class="embedded-calc__header">
          <div class="embedded-calc__title">Work Hours Calculator</div>
          <div class="embedded-calc__subtitle">Adjust break duration and times for your shift</div>
        </div>
        <WorkHoursCalc client:visible lang="en"
          defaultStart={formatHour24(range.start)}
          defaultEnd={formatHour24(range.end)}
          defaultBreak={30}
        />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <h2 style="margin-bottom: 20px;">Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqs.map(faq => (
          <div class="faq-item">
            <button class="faq-item__question" aria-expanded="false">
              {faq.q}
              <span class="faq-arrow">▾</span>
            </button>
            <div class="faq-item__answer">{faq.a}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="internal-links">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.2rem; margin: 0;">🔗 Similar Shifts</h2>
        </div>
        <div class="link-grid">
          {similarRanges.map(r => (
            <a href={getWorkHoursUrl(lang, r.slug)} class="link-card">
              <span>Work Hours {formatHour24(r.start)}–{formatHour24(r.end)}</span>
              <span class="link-card__arrow">→</span>
            </a>
          ))}
          <a href={getTimeRangeUrl(lang, range.slug)} class="link-card">
            <span>Hours between {start24} and {end24}</span>
            <span class="link-card__arrow">→</span>
          </a>
          <a href={getHubUrl(lang)} class="link-card">
            <span>← Time Calculator</span>
            <span class="link-card__arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
