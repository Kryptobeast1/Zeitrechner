---
// /en/work-hours-[slug]/
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkHoursCalc from '../../components/calculator/WorkHoursCalc';
import { ALL_TIME_RANGES, INDEXED_RANGES, formatHour24, getRangeHours, getSimilarRanges } from '../../data/timeRanges';
import type { TimeRange } from '../../data/timeRanges';
import { buildSEOMeta, buildFAQSchema, buildBreadcrumbSchema, getWorkHoursUrl, getTimeRangeUrl, getHubUrl, shouldIndex } from '../../lib/seoEngine';
import { workHoursIntros_en, workHoursFaqSets_en, getContextClusterEN, variantIndex } from '../../data/contentVariants';
import { computeShiftFromHours } from '../../lib/shift';

export async function getStaticPaths() {
  // Canonical English slug only. Legacy slugs are 301'd via vercel.json.
  return ALL_TIME_RANGES.map(range => ({ params: { slug: range.slug }, props: { range } }));
}

interface Props { range: TimeRange; }
const { range } = Astro.props as Props;

const lang = 'en';
const hours = getRangeHours(range.start, range.end);
const start24 = formatHour24(range.start);
const end24 = formatHour24(range.end);

const BREAK_OPTIONS = [0, 30, 45, 60];
const breakResults = BREAK_OPTIONS.map(b => ({
  break: b,
  result: computeShiftFromHours(range.start, range.end, b, 'en'),
}));
const net30 = breakResults[1].result; // canonical answer: 30-min break

const canonical = getWorkHoursUrl(lang, range.slug);
const altUrl = getWorkHoursUrl('de', range.deSlug);

const hreflang = [
  { lang: 'en', url: canonical },
  { lang: 'de', url: altUrl },
  { lang: 'x-default', url: canonical },
];

const vi = variantIndex(range.slug + 'work', workHoursIntros_en.length);
const introHtml = workHoursIntros_en[vi](start24, end24, net30.netDecimalStr);
const contextText = getContextClusterEN(range.start, range.end, hours);

const faqs = workHoursFaqSets_en[0](start24, end24, net30.netDecimal);
const similarRanges = getSimilarRanges(range, 6);

const isIndexed = shouldIndex('work-hours', range.demandScore) || range.workShift;

const seoMeta = buildSEOMeta(
  'work-hours', lang,
  { start: start24, end: end24, net: net30.netDecimalStr },
  canonical, 'de', altUrl,
  !isIndexed
);

const jsonLd = [
  buildFAQSchema(faqs),
  buildBreadcrumbSchema([
    { name: 'Home', url: getHubUrl(lang) },
    { name: `Work Hours ${start24}–${end24}`, url: canonical },
  ]),
];

const lastUpdated = new Date().toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={seoMeta.title}
  description={seoMeta.description}
  canonical={seoMeta.canonical}
  hreflang={seoMeta.hreflang}
  lang={lang}
  jsonLd={jsonLd}
  ogImage={seoMeta.ogImage}
  ogImageAlt={seoMeta.ogImageAlt}
  theme="work-hours"
>

  <section class="section landing-hero" style="padding-bottom: 2rem;">
    <div class="container">
      <nav class="breadcrumb">
        <a href={getHubUrl(lang)}>Home</a>
        <span class="breadcrumb__sep">›</span>
        <span aria-current="page">Work Hours {start24}–{end24}</span>
      </nav>

      <div class="dashboard-grid" style="margin-top: 1.5rem; align-items: center;">
        <!-- Left: Payroll Comparison Card -->
        <div>
          <div class="payroll-sheet">
            <h3 style="margin-top: 0; margin-bottom: 20px; font-size: 1.1rem; display: flex; align-items: center; gap: 8px; color: var(--clr-text);">
              📊 Net Work Time Comparison
            </h3>
            {breakResults.map(br => {
              const pct = br.result.grossMin > 0 ? (br.result.netMin / br.result.grossMin) * 100 : 0;
              return (
                <div class="payroll-row">
                  <div class="payroll-info">
                    <span class="payroll-label">
                      {br.break === 0 ? 'No break' : `${br.break} min break`}
                    </span>
                    <span class="payroll-val">
                      <span data-result={`net-hhmm-${br.break}`}>{br.result.netHHMM}</span> (<span data-result={`net-decimal-${br.break}`}>{br.result.netDecimalStr}</span>h)
                    </span>
                  </div>
                  <div class="payroll-bar-track">
                    <div class="payroll-bar-fill" style={`width: ${pct}%`} />
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Right: Text & Featured Snippet -->
        <div>
          <div class="landing-hero__meta" style="margin-bottom: 1rem;">
            <span class="badge badge--green">💼 Work Hours</span>
            <span class="badge badge--accent">{hours}h Shift</span>
            <span class="last-updated">Last updated: {lastUpdated}</span>
          </div>

          <h1 style="font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 1.5rem; line-height: 1.3;">
            Work Hours {start24} to {end24} — Net Time Calculator
          </h1>

          <div class="featured-snippet" role="complementary" aria-label="Quick Answer" style="margin: 0;">
            <div class="featured-snippet__label">Quick Answer</div>
            <div class="featured-snippet__answer"><span data-result="net-hhmm-30">{net30.netHHMM}</span> net</div>
            <p class="featured-snippet__sentence" style="margin-top: var(--space-2); margin-bottom: 0;">
              Working from {start24} to {end24} with a 30-minute break gives you <strong><span data-result="net-decimal-30">{net30.netDecimalStr}</span> net hours</strong>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Prose and legal warning -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="dashboard-grid" style="align-items: start;">
        <!-- Left: Prose Content -->
        <div class="content-prose">
          <p set:html={introHtml} />
          <p style="margin-top: 15px;">{contextText}</p>
          <br />
          <p>
            For payroll purposes, the decimal format matters: <strong>{net30.netDecimalStr} hours</strong>
            can be multiplied directly by your hourly rate. With a 45-minute break you get {breakResults[2].result.netDecimalStr} hours,
            and with a full hour's break, {breakResults[3].result.netDecimalStr} net hours.
          </p>
        </div>

        <!-- Right: Sticky Expert Box -->
        <div>
          <div class="glass glass--accent expert-box" style="position: sticky; top: 96px; padding: 24px; border-radius: 12px;">
            <h3 style="margin-top: 0; margin-bottom: 12px; font-size: 1.1rem; display: flex; align-items: center; gap: 8px;">
              ⚖️ Expert Insight: Precision in Payroll
            </h3>
            <p style="font-size: 0.9rem; margin-bottom: 12px; color: var(--clr-text-2);">
              Accurate time tracking is essential for both compliance and fair compensation:
            </p>
            <ul style="margin-bottom: 12px; padding-left: 20px; font-size: 0.85rem; color: var(--clr-text-2); display: flex; flex-direction: column; gap: 6px;">
              <li><strong>Decimal Conversion:</strong> Converting hours to decimals ensures zero rounding errors for payroll.</li>
              <li><strong>UK Regulations:</strong> The Working Time Regulations specify mandatory breaks for long shifts.</li>
              <li><strong>FLSA Compliance:</strong> US employers must keep precise logs of unpaid break durations.</li>
            </ul>
            <p style="margin-top: 15px; margin-bottom: 0; font-size: 0.8rem; color: var(--clr-text-3);">
              <em>Note: This tool is designed to provide quick, precise calculations for your daily timesheets.</em>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <div class="embedded-calc">
        <div class="embedded-calc__header">
          <div class="embedded-calc__title">Work Hours Calculator</div>
          <div class="embedded-calc__subtitle">Adjust break duration and times for your shift</div>
        </div>
        <WorkHoursCalc client:visible lang="en"
          defaultStart={formatHour24(range.start)}
          defaultEnd={formatHour24(range.end)}
          defaultBreak={30}
        />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;" id="faq-section">
    <div class="container container--narrow">
      <h2 style="margin-bottom: 20px;">Frequently Asked Questions</h2>
      <div class="faq-list" itemscope itemtype="https://schema.org/FAQPage">
        {faqs.map((faq, idx) => (
          <div class="faq-item" id={`faq-${idx}`} itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
            <button class="faq-item__question" aria-expanded="false" itemprop="name" aria-controls={`faq-answer-${idx}`}>
              {faq.q}
              <span class="faq-arrow" aria-hidden="true">▾</span>
            </button>
            <div class="faq-item__answer" id={`faq-answer-${idx}`} aria-hidden="true" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
              <span itemprop="text">{faq.a}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="internal-links">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.2rem; margin: 0;">🔗 Similar Shifts</h2>
        </div>
        <div class="link-grid">
          {similarRanges.map(r => (
            <a href={getWorkHoursUrl(lang, r.slug)} class="link-card">
              <span>Work Hours {formatHour24(r.start)}–{formatHour24(r.end)}</span>
              <span class="link-card__arrow">→</span>
            </a>
          ))}
          <a href={getTimeRangeUrl(lang, range.slug)} class="link-card">
            <span>Hours between {start24} and {end24}</span>
            <span class="link-card__arrow">→</span>
          </a>
          <a href={getHubUrl(lang)} class="link-card">
            <span>← Time Calculator</span>
            <span class="link-card__arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
