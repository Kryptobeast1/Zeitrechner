---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getHubUrl, getFullUrl, buildBreadcrumbSchema, buildFAQSchema } from '../../lib/seoEngine';

const lang = 'en';
const canonical = '/en/rest-period-germany/';

const faqs = [
  { q: 'How long is the rest period between shifts in Germany?', a: 'Under § 5 of the Working Time Act (ArbZG), at least 11 consecutive hours of rest must fall between the end of one working day and the start of the next. This is separate from the break within a shift (§ 4).' },
  { q: 'When can I start work again after finishing at 22:00?', a: 'Add 11 hours: after finishing at 22:00, the earliest permitted next start is 09:00 the following day. The rest period must be uninterrupted.' },
  { q: 'Which sectors may shorten the rest period to 10 hours?', a: 'Under § 5 (2) ArbZG, hospitals and care, hospitality and hotels, transport, agriculture and broadcasting may reduce the rest to 10 hours — provided each shortening is offset by another rest period of at least 12 hours within one calendar month or four weeks.' },
  { q: 'Does a short work call interrupt the rest period?', a: 'Yes. The rest must be uninterrupted. A work-related interruption — such as a call-out during on-call standby or answering emails — generally restarts the 11-hour clock.' },
  { q: 'Does on-call standby count as rest?', a: 'Pure standby (Rufbereitschaft), where you may stay at a place of your choosing, largely counts as rest until an actual call-out. On-site availability duty (Bereitschaftsdienst) counts fully as working time and interrupts the rest period.' },
  { q: 'Is there also a weekly rest period?', a: 'Yes. In addition to the daily 11-hour rest, Sunday is generally work-free (§ 9 ArbZG). Combined with the daily rest, this gives a continuous weekend rest of at least 35 hours.' },
];

const jsonLd = [buildFAQSchema(faqs), buildBreadcrumbSchema([{ name: 'Home', url: getHubUrl(lang) }, { name: 'Rest Period in Germany', url: canonical }])];
---
<BaseLayout
  title="Rest Period in Germany (§ 5 ArbZG) — the 11-Hour Rule"
  description="Germany's 11-hour rest period between shifts explained in English: earliest next start, the 10-hour exception by sector, interruptions and on-call rules (§ 5 ArbZG). For expats & HR."
  canonical={getFullUrl(canonical)}
  hreflang={[{ lang: 'en', url: getFullUrl(canonical) }, { lang: 'de', url: getFullUrl('/ruhezeit-checker/') }, { lang: 'x-default', url: getFullUrl('/ruhezeit-checker/') }]}
  langAlternates={{ de: '/ruhezeit-checker/', en: canonical }}
  lang={lang}
  jsonLd={jsonLd}
  theme="info"
>
  <section class="section landing-hero" style="padding-bottom: 1.5rem;">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/en/">Home</a><span class="breadcrumb__sep">›</span><span aria-current="page">Rest Period in Germany</span></nav>
      <div style="margin-top: 1.5rem; max-width: 760px;">
        <span class="badge badge--green">Germany · § 5 ArbZG</span>
        <h1 style="margin: 0.5rem 0 0.75rem;">Rest Period in Germany: the 11-Hour Rule</h1>
        <p class="landing-hero__lead">"Can I start again at 6 a.m.?" German law requires 11 hours of uninterrupted rest between the end of one shift and the start of the next. Here is how it works, and when it can drop to 10.</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <div class="content-section content-prose">
        <div class="featured-snippet" role="complementary" aria-label="Quick answer" style="margin: 0 0 28px;">
          <div class="featured-snippet__label">In short</div>
          <p class="featured-snippet__sentence" style="margin: 8px 0 0;">
            <strong>Under § 5 ArbZG, at least 11 uninterrupted hours of rest must fall between two shifts.</strong>
            The earliest next start is simply end time + 11 hours (finish at 22:00 → start no earlier than 09:00).
            Some sectors may reduce it to 10 hours if compensated within four weeks.
          </p>
        </div>

        <h2>What the 11-hour rest means</h2>
        <p>
          The <strong>rest period</strong> is the gap between the end of one working day and the start of the next. It is
          distinct from the break <em>within</em> a shift (§ 4): the break interrupts a day; the rest separates two days.
          It must be uninterrupted.
        </p>
        <div style="overflow-x: auto; margin: 20px 0;">
          <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem; text-align: left; min-width: 420px;">
            <thead><tr style="border-bottom: 2px solid var(--rule);"><th style="padding: 10px;">Shift ends at</th><th style="padding: 10px;">Earliest next start (11h)</th></tr></thead>
            <tbody>
              <tr style="border-bottom: 1px solid var(--rule);"><td style="padding: 10px;">18:00</td><td style="padding: 10px;">05:00</td></tr>
              <tr style="border-bottom: 1px solid var(--rule);"><td style="padding: 10px;">20:00</td><td style="padding: 10px;">07:00</td></tr>
              <tr style="border-bottom: 1px solid var(--rule);"><td style="padding: 10px;">22:00</td><td style="padding: 10px;">09:00</td></tr>
              <tr style="border-bottom: 1px solid var(--rule);"><td style="padding: 10px;">00:00</td><td style="padding: 10px;">11:00</td></tr>
            </tbody>
          </table>
        </div>

        <h2>The 10-hour exception</h2>
        <p>
          In hospitals and care, hospitality, transport, agriculture and broadcasting, the rest may be shortened to
          <strong>10 hours</strong> (§ 5 (2) ArbZG) — but every shortening must be offset by another rest period of at least
          12 hours within one calendar month or four weeks. So a hospital shift ending at 22:00 could, where permitted, resume
          at 08:00.
        </p>

        <h2>Interruptions and on-call duty</h2>
        <p>
          A work call-out during the rest generally restarts the 11-hour clock. Pure on-call standby (Rufbereitschaft) counts as
          rest until an actual call-out; on-site availability duty (Bereitschaftsdienst) counts fully as working time.
        </p>
      </div>

      <div class="internal-links" style="margin-top: 32px;">
        <div class="internal-links__header"><h2 class="internal-links__title" style="font-size: 1.2rem; margin: 0;">Working time in Germany</h2></div>
        <div class="link-grid">
          <a href="/en/german-working-hours-calculator/" class="link-card"><span>German working hours calculator</span><span class="link-card__arrow">→</span></a>
          <a href="/en/break-rules-germany/" class="link-card"><span>Break rules in Germany (§ 4 ArbZG)</span><span class="link-card__arrow">→</span></a>
          <a href="/en/night-work-germany/" class="link-card"><span>Night work & pay in Germany</span><span class="link-card__arrow">→</span></a>
          <a href="/ruhezeit-checker/" class="link-card"><span>Ruhezeit-Checker (auf Deutsch)</span><span class="link-card__arrow">→</span></a>
        </div>
      </div>

      <div class="content-section"><h2>Frequently asked questions</h2>
        <div class="faq-list" itemscope itemtype="https://schema.org/FAQPage">
          {faqs.map(f => (
            <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
              <button class="faq-item__question" aria-expanded="false" itemprop="name">{f.q}<span class="faq-arrow" aria-hidden="true">▾</span></button>
              <div class="faq-item__answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer"><span itemprop="text">{f.a}</span></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
