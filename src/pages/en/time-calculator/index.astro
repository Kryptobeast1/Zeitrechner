---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ModeTabbar from '../../../components/calculator/ModeTabbar';
import { buildWebAppSchema, buildBreadcrumbSchema, getHubUrl, getTimeRangeUrl, getCountdownUrl } from '../../../lib/seoEngine';
import { INDEXED_RANGES, formatHour24 } from '../../../data/timeRanges';
import { INDEXED_EVENTS } from '../../../data/dateEvents';

const lang = 'en';
const canonical = getHubUrl(lang);
const altUrl = getHubUrl('de');
const lastUpdated = new Date().toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

const hreflang = [
  { lang: 'en', url: canonical },
  { lang: 'de', url: altUrl },
  { lang: 'x-default', url: canonical },
];

const jsonLd = [
  buildWebAppSchema(lang),
  buildBreadcrumbSchema([
    { name: 'Home', url: 'https://zeitrechner.app/' },
    { name: 'Time Calculator', url: canonical },
  ]),
];

const popularRanges = INDEXED_RANGES.filter(r => r.priority === 'high').slice(0, 9);
const popularEvents = INDEXED_EVENTS.filter(e => e.priority === 'high').slice(0, 6);
const currentTime = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
---

<BaseLayout
  title="Time Calculator — Hours, Work Hours, Countdown & More | Free Online Tool"
  description="Free online time calculator. Calculate time differences, add or subtract hours, track work hours with breaks, and create live countdowns. Fast, accurate, mobile-friendly."
  canonical={canonical}
  hreflang={hreflang}
  lang={lang}
  jsonLd={jsonLd}
>

  <!-- ─── HERO ───────────────────────────────────────────────────────────── -->
  <section class="section landing-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">›</span>
        <span aria-current="page">Time Calculator</span>
      </nav>

      <div class="landing-hero__meta">
        <span class="badge badge--accent">⚡ Free</span>
        <span class="badge badge--violet">🌍 English</span>
        <span class="badge badge--green">✓ DST-safe</span>
      </div>

      <h1>Time Calculator — Hours, Work Hours & Countdowns</h1>

      <p class="landing-hero__lead">
        Calculate time differences, add or subtract hours, track net work hours, and count days until any event.
        <strong>5 modes, instant results, no sign-up required.</strong>
      </p>

      <div style="display: flex; align-items: center; gap: 12px; margin-top: 20px;">
        <span style="font-size: 0.8rem; color: var(--clr-text-3);">Current time:</span>
        <span id="live-time-en" style="font-family: var(--font-mono); font-size: 1.1rem; font-weight: 700; color: var(--clr-accent);">{currentTime}</span>
        <span class="last-updated">Last updated: {lastUpdated}</span>
      </div>
    </div>
  </section>

  <!-- ─── CALCULATOR ─────────────────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0;" id="diff">
    <div class="container">
      <ModeTabbar client:load lang="en" />
    </div>
  </section>

  <!-- ─── QUICK STATS ────────────────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="stat-grid">
        <div class="stat-card">
          <span class="stat-card__value">8h</span>
          <span class="stat-card__label">Hours from 9 AM to 5 PM</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">7.5h</span>
          <span class="stat-card__label">Net (30 min break)</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">480</span>
          <span class="stat-card__label">Minutes in a workday</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">168</span>
          <span class="stat-card__label">Hours in a week</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── POPULAR TIME RANGES ────────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0;" id="work">
    <div class="container">
      <!-- Guides Section -->
      <section class="guides-section">
        <h3>📖 Guides & Resources</h3>
        <div class="link-grid">
          <a href="/en/guides/how-to-calculate-work-hours/" class="glass-card link-item">
            <span class="icon">💼</span>
            <div class="link-info">
              <span class="label">Calculating Work Hours</span>
              <span class="sub">Ultimate Guide 2025</span>
            </div>
          </a>
          <a href="/en/guides/tracking-time-freelancers/" class="glass-card link-item">
            <span class="icon">🚀</span>
            <div class="link-info">
              <span class="label">Freelancer Time Tracking</span>
              <span class="sub">Maximize your income</span>
            </div>
          </a>
        </div>
      </section>

      <!-- Internal Link Mesh -->
      <div class="internal-links">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.4rem; margin: 0;">⏰ Popular Time Ranges</h2>
        </div>
        <div class="link-grid">
          {popularRanges.map(r => {
            const hours = r.end > r.start ? r.end - r.start : 24 - r.start + r.end;
            return (
              <a href={getTimeRangeUrl(lang, r.slug)} class="link-card">
                <span>Hours between {formatHour24(r.start)} and {formatHour24(r.end)}</span>
                <span class="link-card__arrow">→</span>
              </a>
            );
          })}
        </div>
      </div>

      <div class="internal-links" style="margin-top: 32px;" id="countdown">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.4rem; margin: 0;">⏳ Countdown Timers</h2>
        </div>
        <div class="link-grid">
          {popularEvents.map(e => (
            <a href={getCountdownUrl(lang, e.slug)} class="link-card">
              <span>Days until {e.name}</span>
              <span class="link-card__arrow">→</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── HOW IT WORKS ───────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container container--narrow">
      <div class="content-section">
        <h2>How the Time Calculator Works</h2>
        <div class="content-prose">
          <p>
            Our time calculator supports five different calculation modes — all free with no sign-up required.
            Calculations run entirely in your browser for <strong>instant results</strong>.
          </p>
          <p>
            <strong>Time Difference:</strong> Enter start and end date/time. Results show days, hours, minutes,
            seconds, and decimal hours — perfect for timesheets and billing.
          </p>
          <p>
            <strong>Work Hours:</strong> Enter start time, end time, and break duration. The calculator
            deducts breaks automatically and flags overtime beyond 8 hours.
          </p>
          <p>
            <strong>From Now:</strong> Enter a duration (e.g., 3 hours) and instantly see what time it will be —
            essential for scheduling and estimating completion times.
          </p>
        </div>
      </div>

      <div class="methodology-box">
        <strong>Methodology:</strong> All calculations use UTC-safe JavaScript Date objects.
        Daylight Saving Time (DST) is handled automatically via the browser's local timezone offset.
        Leap years are fully supported.
      </div>
    </div>
  </section>

</BaseLayout>

<script>
const liveTimeEn = document.getElementById('live-time-en');
if (liveTimeEn) {
  setInterval(() => {
    liveTimeEn.textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  }, 1000);
}
</script>
