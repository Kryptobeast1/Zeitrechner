---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModeTabbar from '../../components/calculator/ModeTabbar';
import { buildWebAppSchema, buildBreadcrumbSchema, getHubUrl, getTimeRangeUrl, getWorkHoursUrl, getCountdownUrl, getGuideUrl, getFullUrl } from '../../lib/seoEngine';
import { INDEXED_RANGES, formatHour24 } from '../../data/timeRanges';
import { INDEXED_EVENTS } from '../../data/dateEvents';

const lang = 'en';
const canonical = getHubUrl(lang); // "/en/"
const altUrl = getHubUrl('de'); // "/"
const lastUpdated = new Date().toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

const homeFaqsEn = [
  { q: 'How do I calculate the time between two times?', a: 'Subtract the start time from the end time. If the start minutes are larger than the end minutes, borrow 60 minutes from the hours column. For example, 09:15 to 17:45 is 8 hours 30 minutes. If the end is earlier than the start, the span runs past midnight, so add 24 hours (22:00 to 06:00 is 8 hours). The calculator handles all of this automatically.' },
  { q: 'How do I convert hours and minutes to decimal hours?', a: 'Divide the minutes by 60 and add them to the whole hours: decimal hours = hours + (minutes ÷ 60). So 8 hours 15 minutes is 8.25 decimal hours. Note that "industrial minutes" are hundredths of an hour, so 30 minutes equals 50 industrial minutes (0.50 h), not 30. Payroll uses decimal hours because they multiply cleanly by an hourly rate.' },
  { q: 'Does the calculator handle 24-hour and 12-hour (AM/PM) time?', a: 'Yes. You can enter time in either the 24-hour format (military time) or the standard 12-hour AM/PM format. To convert a PM time to 24-hour, add 12 to the hour (1 PM = 13:00). The duration is identical in both formats.' },
  { q: 'Is the calculator safe for Daylight Saving Time (DST) and leap years?', a: 'Yes. It uses your device\'s local timezone offset to compute durations and countdowns that safely cross DST changes, leap years, and date boundaries.' },
  { q: 'What is the difference between gross and net work hours?', a: 'Gross hours are the total time from clock-in to clock-out. Net hours are what remain after deducting unpaid breaks, and they are the basis for pay. For example, 09:00 to 17:30 is 8.5 gross hours; with a 30-minute break, 8.0 net hours remain. Under the US FLSA, unpaid meal breaks do not count as working time.' },
  { q: 'Is the time calculator free and does it require sign-up?', a: 'Yes. Every mode — time difference, work hours, add/subtract, and countdown — is free, requires no registration, and runs entirely in your browser. Your inputs are processed locally on your device and are never sent to a server.' }
];

const hreflang = [
  { lang: 'en', url: getFullUrl(canonical) },
  { lang: 'de', url: getFullUrl(altUrl) },
  { lang: 'x-default', url: getFullUrl(canonical) },
];

const jsonLd = [
  buildWebAppSchema(lang),
  buildBreadcrumbSchema([
    { name: 'Home', url: canonical },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaqsEn.map(faq => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  }
];

const popularRanges = INDEXED_RANGES.filter(r => r.priority === 'high').slice(0, 9);
const popularEvents = INDEXED_EVENTS.filter(e => e.priority === 'high').slice(0, 6);
const currentTime = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
---

<BaseLayout
  title={`Time Calculator ${new Date().getFullYear()} — Duration, Work Hours & Countdown (Free)`}
  description="Free online time calculator: find the duration between two times, add or subtract hours, calculate net work hours with breaks and decimal hours, and count the days to any event. No sign-up."
  canonical={getFullUrl(canonical)}
  hreflang={hreflang}
  lang={lang}
  jsonLd={jsonLd}
  theme="home"
>

  <!-- ─── HERO (centered, calculator-first) ──────────────────────────────── -->
  <section class="section landing-hero" style="padding-bottom: 2rem;">
    <div class="container">
      <div class="hero-centered">
        <div class="landing-hero__meta">
          <span class="badge badge--accent">Free</span>
          <span class="badge badge--violet">English</span>
          <span class="badge badge--green">DST-safe</span>
        </div>

        <h1 style="margin-bottom: 1.25rem;">Time Calculator — Hours Between Times, Work Hours & Countdowns</h1>

        <p class="landing-hero__lead">
          Find the duration between two times, add or subtract hours, calculate net work hours with breaks and
          decimal hours, and count the days until any event.
          <strong>5 modes, instant results, no sign-up required.</strong>
        </p>

        <!-- Calculator -->
        <div class="home-hero-calc calc-shell" id="diff">
          <div class="glass glass--raised">
            <ModeTabbar client:visible lang="en" />
          </div>
        </div>

        <!-- Live time (client-only; no build-time value is baked into the HTML) -->
        <div class="live-chip">
          <span>Current time:</span>
          <span id="live-time-en" aria-live="off"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── QUICK ANSWER (featured-snippet target) ─────────────────────────── -->
  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <div class="featured-snippet" role="complementary" aria-label="Quick answer">
        <div class="featured-snippet__label">How to calculate the time between two times</div>
        <p class="featured-snippet__sentence" style="margin: 8px 0 0;">
          Subtract the start time from the end time; if the start minutes are larger, borrow 60 minutes from the hour.
          <strong>Example: 09:15 to 17:45 is 8 hours 30 minutes, or 8.5 decimal hours.</strong> For a span that runs past
          midnight, add 24 hours (22:00 to 06:00 = 8 hours). The calculator above works in both 24-hour and 12-hour
          (AM/PM) time and does this automatically.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── QUICK STATS ────────────────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="stat-grid">
        <div class="stat-card">
          <span class="stat-card__value">8h</span>
          <span class="stat-card__label">Hours from 9 AM to 5 PM</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">7.5h</span>
          <span class="stat-card__label">Net (30 min break)</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">480</span>
          <span class="stat-card__label">Minutes in a workday</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">168</span>
          <span class="stat-card__label">Hours in a week</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── POPULAR TIME RANGES ────────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0;" id="work">
    <div class="container">
      <!-- Guides Section -->
      <section class="guides-section">
        <h3>Guides & Resources</h3>
        <div class="link-grid">
          <a href={getGuideUrl(lang, 'how-to-calculate-work-hours')} class="glass-card link-item">
            <span class="icon"></span>
            <div class="link-info">
              <span class="label">Calculating Work Hours</span>
              <span class="sub">Ultimate Guide 2026</span>
            </div>
          </a>
          <a href={getGuideUrl(lang, 'tracking-time-freelancers')} class="glass-card link-item">
            <span class="icon"></span>
            <div class="link-info">
              <span class="label">Freelancer Time Tracking</span>
              <span class="sub">Maximize your income</span>
            </div>
          </a>
        </div>
      </section>

      <!-- Working time in Germany (English cluster) -->
      <div class="internal-links" id="germany">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.4rem; margin: 0;">Working Time in Germany (in English)</h2>
        </div>
        <div class="link-grid">
          <a href="/en/german-working-hours-calculator/" class="link-card"><span>German working hours calculator (ArbZG)</span><span class="link-card__arrow">→</span></a>
          <a href="/en/break-rules-germany/" class="link-card"><span>Break rules in Germany (§ 4 ArbZG)</span><span class="link-card__arrow">→</span></a>
          <a href="/en/overtime-in-germany/" class="link-card"><span>Overtime in Germany</span><span class="link-card__arrow">→</span></a>
          <a href="/en/rest-period-germany/" class="link-card"><span>Rest period (11-hour rule, § 5 ArbZG)</span><span class="link-card__arrow">→</span></a>
          <a href="/en/night-work-germany/" class="link-card"><span>Night work, supplement & tax</span><span class="link-card__arrow">→</span></a>
          <a href="/en/vacation-entitlement-germany/" class="link-card"><span>Vacation entitlement (BUrlG)</span><span class="link-card__arrow">→</span></a>
          <a href="/en/german-public-holidays/" class="link-card"><span>German public holidays by state</span><span class="link-card__arrow">→</span></a>
          <a href="/en/decimal-hours-calculator/" class="link-card"><span>Decimal hours calculator</span><span class="link-card__arrow">→</span></a>
        </div>
      </div>

      <!-- Working Hours Calculator Section -->
      <div class="internal-links" id="working-hours">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.4rem; margin: 0;">Working Hours Calculator</h2>
        </div>
        <div class="link-grid">
          {INDEXED_RANGES.filter(r => r.workShift).map(r => (
            <a href={`${getTimeRangeUrl(lang, r.slug)}#work-hours`} class="link-card">
              <span>Working hours {formatHour24(r.start)} – {formatHour24(r.end)}</span>
              <span class="link-card__arrow">→</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Internal Link Mesh -->
      <div class="internal-links" id="ranges">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.4rem; margin: 0;">Popular Time Ranges</h2>
        </div>
        <div class="link-grid">
          {popularRanges.map(r => (
            <a href={getTimeRangeUrl(lang, r.slug)} class="link-card">
              <span>Hours between {formatHour24(r.start)} and {formatHour24(r.end)}</span>
              <span class="link-card__arrow">→</span>
            </a>
          ))}
        </div>
      </div>

      <div class="internal-links" style="margin-top: 32px;" id="countdown">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.4rem; margin: 0;">Countdown Timers</h2>
        </div>
        <div class="link-grid">
          {popularEvents.map(e => (
            <a href={getCountdownUrl(lang, e.slug)} class="link-card">
              <span>Days until {e.name}</span>
              <span class="link-card__arrow">→</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── ULTIMATE GUIDE / E-E-A-T SECTION ───────────────────────────────── -->
  <article class="section semantic-guide" style="background-color: var(--clr-surf-1); border-top: 1px solid var(--clr-border);">
    <div class="container container--narrow">
      <div class="content-section">
        <h2>How to Calculate Duration, Work Hours, and Countdowns</h2>
        <div class="content-prose">
          <p>
            Accurate <strong>time calculation</strong> is the backbone of fair pay, correct invoices, and reliable planning.
            Whether you are a freelancer logging <em>billable hours</em>, an HR manager checking Fair Labor Standards Act (FLSA)
            compliance, or simply counting the days to an event, this calculator gives exact, to-the-minute results — free,
            with no sign-up, right in your browser.
          </p>

          <h3>Calculating the hours between two times</h3>
          <p>
            Subtract the start time from the end time. If the start minutes are larger than the end minutes, borrow 60 minutes
            from the hours column. For example, <strong>09:15 to 17:45</strong> is <code>8 hours 30 minutes</code>. If the end is
            earlier than the start, the span runs past midnight — just carry the count into the next day (22:00 to 06:00 is 8 hours).
            This <strong>gross duration</strong> is the raw span before any break is deducted.
          </p>

          <h3>Gross vs. net hours and converting to decimal</h3>
          <p>
            <strong>Net work time</strong> is what remains after you subtract unpaid breaks from the gross span. Payroll records it
            in <strong>decimal hours</strong> rather than hours-and-minutes: decimal hours = hours + (minutes ÷ 60), so 8 hours
            15 minutes is <code>8.25 decimal hours</code>. <em>Industrial minutes</em> are hundredths of an hour — 30 real minutes
            equal 50 industrial minutes (0.50 h), not 30. The calculator returns gross, net, and the decimal value in one step,
            so you can multiply directly by your hourly wage.
          </p>

          <h3>Breaks, overtime, and time zones</h3>
          <p>
            Most labour rules require an unpaid rest break — typically 20–30 minutes — once a shift passes 6 hours, and that break
            is not paid working time. Under the US FLSA, <strong>overtime</strong> is a weekly threshold: hours worked beyond 40 in
            a workweek are paid at 1.5× the regular rate, not simply anything over 8 in a day. All calculations also account for
            <strong>leap years</strong> and Daylight Saving Time (DST) by reading your browser's local timezone offset.
          </p>
        </div>
      </div>

      <div class="content-section" style="margin-top: 40px;">
        <h2>Frequently Asked Questions (FAQ)</h2>
        <div class="faq-list" itemscope itemtype="https://schema.org/FAQPage">
          {homeFaqsEn.map(faq => (
            <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
              <button class="faq-item__question" aria-expanded="false" itemprop="name">
                {faq.q}
                <span class="faq-arrow" aria-hidden="true">▾</span>
              </button>
              <div class="faq-item__answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <span itemprop="text">{faq.a}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </article>

</BaseLayout>

<script>
const liveTimeEn = document.getElementById('live-time-en');
if (liveTimeEn) {
  const tick = () => { liveTimeEn.textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit' }); };
  tick();
  setInterval(tick, 1000);
}
</script>
