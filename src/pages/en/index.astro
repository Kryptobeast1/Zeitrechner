---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModeTabbar from '../../components/calculator/ModeTabbar';
import { buildWebAppSchema, buildBreadcrumbSchema, getHubUrl, getTimeRangeUrl, getWorkHoursUrl, getCountdownUrl, getGuideUrl, getFullUrl } from '../../lib/seoEngine';
import { INDEXED_RANGES, formatHour24 } from '../../data/timeRanges';
import { INDEXED_EVENTS } from '../../data/dateEvents';

const lang = 'en';
const canonical = getHubUrl(lang); // "/en/"
const altUrl = getHubUrl('de'); // "/"
const lastUpdated = new Date().toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

const homeFaqsEn = [
  { q: 'How do I convert hours and minutes to decimal hours for payroll?', a: 'Divide the minutes by 60. For example, 45 minutes is 0.75 decimal hours. Our working hours calculator does this automatically to ensure your timesheet is ready for billing.' },
  { q: 'Does this calculator handle military time and AM/PM?', a: 'Yes. You can input time in either the 24-hour format (military time) or the standard 12-hour AM/PM format. The calculator seamlessly processes both.' },
  { q: 'Is the time difference calculator safe for Daylight Saving Time (DST)?', a: 'Absolutely. It uses your device\'s local timezone offset to safely compute durations that cross DST boundaries or leap years.' }
];

const hreflang = [
  { lang: 'en', url: getFullUrl(canonical) },
  { lang: 'de', url: getFullUrl(altUrl) },
  { lang: 'x-default', url: getFullUrl(canonical) },
];

const jsonLd = [
  buildWebAppSchema(lang),
  buildBreadcrumbSchema([
    { name: 'Home', url: canonical },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaqsEn.map(faq => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  }
];

const popularRanges = INDEXED_RANGES.filter(r => r.priority === 'high').slice(0, 9);
const popularEvents = INDEXED_EVENTS.filter(e => e.priority === 'high').slice(0, 6);
const currentTime = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
---

<BaseLayout
  title="Time Calculator 2026 — Hours, Work Hours & Countdown Online"
  description="Precise online time calculator for 2026. Calculate time differences, work hours with breaks, and live countdowns. Free and mobile-friendly."
  canonical={getFullUrl(canonical)}
  hreflang={hreflang}
  lang={lang}
  jsonLd={jsonLd}
  theme="home"
>

  <!-- ─── HERO & CALCULATOR GRID ─────────────────────────────────────────── -->
  <section class="section landing-hero" style="padding-bottom: 2rem;">
    <div class="container">
      <div class="home-hero-grid">
        <!-- Hero text column -->
        <div class="home-hero-content">
          <div class="landing-hero__meta">
            <span class="badge badge--accent">⚡ Free</span>
            <span class="badge badge--violet">🌍 English</span>
            <span class="badge badge--green">✓ DST-safe</span>
          </div>

          <h1 style="margin-bottom: 1.5rem;">Time Calculator — Hours, Work Hours & Countdowns</h1>

          <p class="landing-hero__lead" style="margin-bottom: 2rem;">
            Calculate time differences, add or subtract hours, track net work hours, and count days until any event.
            <strong>5 modes, instant results, no sign-up required.</strong>
          </p>

          <!-- Live time -->
          <div style="display: flex; align-items: center; gap: 12px; margin-top: 20px; background: var(--clr-surface-2); padding: 12px 16px; border-radius: var(--radius); border: 1px solid var(--clr-border); width: fit-content; flex-wrap: wrap;">
            <span style="font-size: 0.8rem; color: var(--clr-text-3);">Current time:</span>
            <span id="live-time-en" style="font-family: var(--font-mono); font-size: 1.1rem; font-weight: 700; color: var(--clr-accent);">{currentTime}</span>
            <span class="last-updated" style="margin-left: 8px;">Updated: {lastUpdated}</span>
          </div>
        </div>

        <!-- Calculator column -->
        <div class="home-hero-calc" id="diff" style="margin-top: 1rem;">
          <div class="glass glass--raised" style="padding: 1.5rem; border-radius: var(--radius-xl); box-shadow: 0 0 30px var(--clr-violet-glow);">
            <ModeTabbar client:visible lang="en" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── QUICK STATS ────────────────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="stat-grid">
        <div class="stat-card">
          <span class="stat-card__value">8h</span>
          <span class="stat-card__label">Hours from 9 AM to 5 PM</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">7.5h</span>
          <span class="stat-card__label">Net (30 min break)</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">480</span>
          <span class="stat-card__label">Minutes in a workday</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__value">168</span>
          <span class="stat-card__label">Hours in a week</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── POPULAR TIME RANGES ────────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0;" id="work">
    <div class="container">
      <!-- Guides Section -->
      <section class="guides-section">
        <h3>📖 Guides & Resources</h3>
        <div class="link-grid">
          <a href={getGuideUrl(lang, 'how-to-calculate-work-hours')} class="glass-card link-item">
            <span class="icon">💼</span>
            <div class="link-info">
              <span class="label">Calculating Work Hours</span>
              <span class="sub">Ultimate Guide 2026</span>
            </div>
          </a>
          <a href={getGuideUrl(lang, 'tracking-time-freelancers')} class="glass-card link-item">
            <span class="icon">🚀</span>
            <div class="link-info">
              <span class="label">Freelancer Time Tracking</span>
              <span class="sub">Maximize your income</span>
            </div>
          </a>
        </div>
      </section>

      <!-- Working Hours Calculator Section -->
      <div class="internal-links" id="working-hours">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.4rem; margin: 0;">💼 Working Hours Calculator</h2>
        </div>
        <div class="link-grid">
          {INDEXED_RANGES.filter(r => r.workShift).map(r => (
            <a href={`${getTimeRangeUrl(lang, r.slug)}#work-hours`} class="link-card">
              <span>Working hours {formatHour24(r.start)} – {formatHour24(r.end)}</span>
              <span class="link-card__arrow">→</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Internal Link Mesh -->
      <div class="internal-links" id="ranges">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.4rem; margin: 0;">⏰ Popular Time Ranges</h2>
        </div>
        <div class="link-grid">
          {popularRanges.map(r => (
            <a href={getTimeRangeUrl(lang, r.slug)} class="link-card">
              <span>Hours between {formatHour24(r.start)} and {formatHour24(r.end)}</span>
              <span class="link-card__arrow">→</span>
            </a>
          ))}
        </div>
      </div>

      <div class="internal-links" style="margin-top: 32px;" id="countdown">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.4rem; margin: 0;">⏳ Countdown Timers</h2>
        </div>
        <div class="link-grid">
          {popularEvents.map(e => (
            <a href={getCountdownUrl(lang, e.slug)} class="link-card">
              <span>Days until {e.name}</span>
              <span class="link-card__arrow">→</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── ULTIMATE GUIDE / E-E-A-T SECTION ───────────────────────────────── -->
  <article class="section semantic-guide" style="background-color: var(--clr-surf-1); border-top: 1px solid var(--clr-border);">
    <div class="container container--narrow">
      <div class="expert-badge" style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px; padding: 12px; background: rgba(50, 205, 50, 0.1); border-radius: 8px;">
        <span style="font-size: 1.5rem;">✅</span>
        <div>
          <div style="font-size: 0.85rem; color: var(--clr-text-2); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Fact Checked</div>
          <div style="font-size: 0.95rem; font-weight: 500;">Verified by HR & Payroll Specialists</div>
        </div>
      </div>

      <div class="content-section">
        <h2>Precise Time Tracking for Payroll and Project Management</h2>
        <div class="content-prose">
          <p>
            Accurate <strong>time tracking</strong> is the backbone of reliable payroll processing and fair labor compliance. 
            Whether you are a freelancer logging <em>billable hours</em> or an HR manager verifying Fair Labor Standards Act (FLSA) compliance, 
            our timesheet calculator provides exact, to-the-minute reports.
          </p>

          <h3>Military Time vs. Decimal Hours</h3>
          <p>
            Standard payroll software doesn't use the typical 60-minute clock; it requires <strong>decimal hours</strong>. 
            For instance, a shift lasting 8 hours and 15 minutes must be recorded as <code>8.25 decimal hours</code>. 
            Our tool automatically translates standard time and military time into this decimal format, ensuring 
            you can multiply your net hours directly by your hourly wage.
          </p>

          <h3>Daylight Saving Time (DST) and Time Zones</h3>
          <p>
            Calculating duration across multiple days can be tricky when dealing with celestial and geopolitical anomalies. 
            Our time difference calculator natively supports <strong>leap years</strong> and dynamically reads your 
            browser's <em>timezone offset</em> to effortlessly adjust for Daylight Saving Time (DST) changes.
          </p>
        </div>
      </div>

      <div class="content-section" style="margin-top: 40px;">
        <h2>Frequently Asked Questions (FAQ)</h2>
        <div class="faq-list" itemscope itemtype="https://schema.org/FAQPage">
          {homeFaqsEn.map(faq => (
            <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
              <button class="faq-item__question" aria-expanded="false" itemprop="name">
                {faq.q}
                <span class="faq-arrow" aria-hidden="true">▾</span>
              </button>
              <div class="faq-item__answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <span itemprop="text">{faq.a}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </article>

</BaseLayout>

<script>
const liveTimeEn = document.getElementById('live-time-en');
if (liveTimeEn) {
  setInterval(() => {
    liveTimeEn.textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  }, 1000);
}
</script>
