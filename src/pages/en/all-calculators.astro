---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HUBS, hubRanges } from '../../lib/hubs';
import { INDEXED_EVENTS } from '../../data/dateEvents';
import { buildSEOMeta, getHubUrl, getCountdownUrl, getFullUrl } from '../../lib/seoEngine';

const lang = 'en';
const title = 'All Calculators & Categories — Zeit-Rechner.com';
const description = 'An overview of the time and work-hours calculators by category: early shifts, 8-hour shifts, night shifts, part-time, and countdowns.';
const canonical = '/en/all-calculators/';
const seo = buildSEOMeta('hub', lang, {}, canonical, 'de', '/alle-rechner/', false);
seo.title = title; seo.description = description;

const currentYear = new Date().getFullYear();
const countdowns = INDEXED_EVENTS
  .filter(e => parseInt(e.targetDate.split('-')[0], 10) >= currentYear)
  .slice(0, 24);
---
<BaseLayout title={seo.title} description={seo.description} canonical={getFullUrl(canonical)} hreflang={seo.hreflang} lang={lang} theme="info" langAlternates={{ de: '/alle-rechner/', en: canonical }}>
  <section class="section landing-hero" style="padding-bottom: 1.5rem;">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={getHubUrl(lang)}>Home</a>
        <span class="breadcrumb__sep">›</span>
        <span aria-current="page">All Calculators</span>
      </nav>
      <div style="margin-top: 1.5rem; max-width: 760px;">
        <h1 style="margin-bottom: 0.75rem;">All Calculators & Categories</h1>
        <p class="landing-hero__lead">{description}</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <h2 style="font-size: 1.3rem; margin-bottom: 1rem;">Shift categories</h2>
      <div class="link-grid">
        {HUBS.map(hub => (
          <a href={`/en/shifts/${hub.slug}/`} class="link-card">
            <span><strong>{hub.enTitle}</strong> · {hubRanges(hub).length} calculators</span>
            <span class="link-card__arrow">→</span>
          </a>
        ))}
      </div>

      <h2 style="font-size: 1.3rem; margin: 2rem 0 1rem;">Countdowns</h2>
      <div class="link-grid">
        {countdowns.map(e => (
          <a href={getCountdownUrl(lang, e.slug)} class="link-card">
            <span>Days until {e.name}</span>
            <span class="link-card__arrow">→</span>
          </a>
        ))}
      </div>

      <h2 style="font-size: 1.3rem; margin: 2rem 0 1rem;">German working time, explained in English</h2>
      <div class="link-grid">
        <a href="/en/german-working-hours-calculator/" class="link-card"><span>German working hours calculator</span><span class="link-card__arrow">→</span></a>
        <a href="/en/working-days-calculator/" class="link-card"><span>Working days calculator (by federal state)</span><span class="link-card__arrow">→</span></a>
        <a href="/en/decimal-hours-calculator/" class="link-card"><span>Decimal hours calculator</span><span class="link-card__arrow">→</span></a>
        <a href="/en/break-rules-germany/" class="link-card"><span>Break rules in Germany (ArbZG)</span><span class="link-card__arrow">→</span></a>
        <a href="/en/rest-period-germany/" class="link-card"><span>Rest period between shifts (11h)</span><span class="link-card__arrow">→</span></a>
        <a href="/en/overtime-in-germany/" class="link-card"><span>Overtime in Germany</span><span class="link-card__arrow">→</span></a>
        <a href="/en/night-work-germany/" class="link-card"><span>Night work & supplements</span><span class="link-card__arrow">→</span></a>
        <a href="/en/vacation-entitlement-germany/" class="link-card"><span>Vacation entitlement (BUrlG)</span><span class="link-card__arrow">→</span></a>
        <a href="/en/german-public-holidays/" class="link-card"><span>German public holidays by state</span><span class="link-card__arrow">→</span></a>
      </div>

      <h2 style="font-size: 1.3rem; margin: 2rem 0 1rem;">Guides</h2>
      <div class="link-grid">
        <a href="/en/guides/" class="link-card"><span>All guide articles</span><span class="link-card__arrow">→</span></a>
        <a href="/en/guides/how-to-calculate-work-hours/" class="link-card"><span>How to calculate work hours</span><span class="link-card__arrow">→</span></a>
        <a href="/en/guides/tracking-time-freelancers/" class="link-card"><span>Time tracking for freelancers</span><span class="link-card__arrow">→</span></a>
        <a href="/en/editorial-guidelines/" class="link-card"><span>Editorial guidelines & team</span><span class="link-card__arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
