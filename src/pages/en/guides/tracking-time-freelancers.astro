---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { buildSEOMeta, getHubUrl } from '../../../lib/seoEngine';

const lang = 'en';
const title = 'Time Tracking for Freelancers: The Ultimate Guide 2026';
const description = 'Maximize your billable hours. Learn how to track time efficiently as a freelancer, calculate hourly rates, and avoid common billing mistakes.';

const seo = buildSEOMeta(
  'hub',
  lang,
  {},
  '/en/guides/tracking-time-freelancers/',
  'de',
  '/ratgeber/zeiterfassung-freelancer/'
);

const hubUrl = getHubUrl(lang);
---

<BaseLayout 
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  hreflang={seo.hreflang}
  lang={lang}
  theme="guide"
>

  <section class="section landing-hero" style="padding-bottom: 2rem;">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={hubUrl}>Home</a>
        <span class="breadcrumb__sep">›</span>
        <a href="/en/guides/">Guides</a>
        <span class="breadcrumb__sep">›</span>
        <span aria-current="page">Freelancer Time Tracking</span>
      </nav>

      <div style="margin-top: 1.5rem;">
        <span class="badge badge--violet">🚀 Freelancer</span>
        <h1 style="margin-top: var(--space-2); margin-bottom: var(--space-4);">{title}</h1>
        <p class="landing-hero__lead" style="max-width: var(--max-width-content);">{description}</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="guide-layout">
        <!-- Sidebar Table of Contents -->
        <aside class="guide-toc" aria-label="Table of Contents">
          <div class="guide-toc__title">Table of Contents</div>
          <ul class="guide-toc__list">
            <li><a href="#estimation" class="guide-toc__link">1. The Cost of Estimation</a></li>
            <li><a href="#billing-units" class="guide-toc__link">2. Billing Units</a></li>
            <li><a href="#productivity-rule" class="guide-toc__link">3. The 60/20/20 Rule</a></li>
            <li><a href="#conclusion" class="guide-toc__link">4. Conclusion & Precision</a></li>
          </ul>
        </aside>

        <!-- Main Editorial Content -->
        <div class="guide-main content-prose">
          <section id="estimation" style="margin-bottom: var(--space-8);">
            <h2 style="margin-bottom: var(--space-3); color: var(--clr-accent);">1. The Cost of "Guess-timation"</h2>
            <p style="margin-bottom: var(--space-4);">Many independent professionals wait until the end of the day or week to estimate their billable time. Studies show that "retroactive tracking" can miss up to 25% of actual billable work — such as quick client calls, urgent emails, or research phases.</p>
            <div class="glass glass--accent" style="padding: var(--space-4); border-radius: var(--radius); margin-bottom: var(--space-4);">
              <strong>💡 Expert Tip:</strong> Use our <a href={hubUrl}>Time Calculator</a> to instantly convert small time increments into billable decimals for your invoices.
            </div>
          </section>

          <section id="billing-units" style="margin-bottom: var(--space-8);">
            <h2 style="margin-bottom: var(--space-3); color: var(--clr-accent);">2. Billing Units: Hours vs. Days</h2>
            <p>Depending on your contract, you may bill by <strong>hourly rates</strong> or <strong>day rates</strong>. A standard day rate usually assumes 8 hours of work. If you work 10 hours, you should bill 1.25 units to ensure fairness.</p>
          </section>

          <section id="productivity-rule" style="margin-bottom: var(--space-8);">
            <h2 style="margin-bottom: var(--space-3); color: var(--clr-accent);">3. The 60/20/20 Rule for Productivity</h2>
            <p style="margin-bottom: var(--space-4);">A balanced freelancer day consists of more than just billable work:</p>
            <ul style="margin-bottom: var(--space-4); padding-left: var(--space-6); list-style-type: disc;">
              <li style="margin-bottom: var(--space-2);"><strong>60% Billable Work:</strong> Core project delivery.</li>
              <li style="margin-bottom: var(--space-2);"><strong>20% Marketing & Sales:</strong> Finding the next project.</li>
              <li style="margin-bottom: var(--space-2);"><strong>20% Admin & Overhead:</strong> Invoicing, learning, and emails.</li>
            </ul>
          </section>

          <section id="conclusion">
            <h2 style="margin-bottom: var(--space-3); color: var(--clr-accent);">4. Conclusion: Precision Wins</h2>
            <p>Regardless of the tool you use, track your time <em>in the moment</em>. Our tool helps you document start and end times precisely and deduct breaks correctly, ensuring every minute counts toward your revenue.</p>
            <div style="margin-top: var(--space-6);">
              <a href={hubUrl} class="btn btn--primary">Start Tracking Project Time</a>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
