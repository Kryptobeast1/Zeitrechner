---
// Programmatic page: /en/hours-between-[slug]/
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkHoursCalc from '../../components/calculator/WorkHoursCalc';
import ShiftVisual from '../../components/ShiftVisual.astro';
import ShiftModules from '../../components/ShiftModules.astro';
import { getArchetype, getBand, getTreatment } from '../../lib/archetype';
import { getShiftModules } from '../../lib/shiftModules';
import { ALL_TIME_RANGES, INDEXED_RANGES, formatHour24, getRangeHours, getSimilarRanges } from '../../data/timeRanges';
import type { TimeRange } from '../../data/timeRanges';
import {
  buildSEOMeta, buildFAQSchema, buildBreadcrumbSchema,
  getTimeRangeUrl, getHubUrl, getWorkHoursUrl, shouldIndex
} from '../../lib/seoEngine';
import {
  timeRangeIntros_en, getContextClusterEN, useCases_en, faqSets_en,
  workHoursFaqSets_en, variantIndex
} from '../../data/contentVariants';
import { computeShiftFromHours } from '../../lib/shift';
import { shouldNoindexByDemand } from '../../lib/keepList';

export async function getStaticPaths() {
  // Canonical English slug only. Legacy slugs are 301'd via vercel.json.
  return ALL_TIME_RANGES.map(range => ({ params: { slug: range.slug }, props: { range } }));
}

interface Props { range: TimeRange; }
const { range } = Astro.props as Props;

const lang = 'en';
const hours = getRangeHours(range.start, range.end);
const start24 = formatHour24(range.start);
const end24 = formatHour24(range.end);

// Single source of truth for the displayed result figures (Phase 1)
const gross = computeShiftFromHours(range.start, range.end, 0, 'en');

// Phase 3.3: this page now also answers net-after-break (merged work-hours content)
const BREAK_OPTIONS = [0, 30, 45, 60];
const breakResults = BREAK_OPTIONS.map(b => ({ break: b, result: computeShiftFromHours(range.start, range.end, b, 'en') }));
const net30 = breakResults[1].result;
const bandBreak = gross.grossMin > 360 ? 30 : 0;

// Phase 5 variation axes
const archetype = getArchetype(range.start, range.end);
const band = getBand(range.start);
const treatment = getTreatment(range.slug);
const shiftModules = getShiftModules(range.start, range.end, archetype);

const canonical = getTimeRangeUrl(lang, range.slug);
const altUrl = getTimeRangeUrl('de', range.deSlug);

const hreflang = [
  { lang: 'en', url: canonical },
  { lang: 'de', url: altUrl },
  { lang: 'x-default', url: canonical },
];

const vi = variantIndex(range.slug, timeRangeIntros_en.length);
const ui = variantIndex(range.slug + 'use', useCases_en.length);
const fi = variantIndex(range.slug + 'faq', faqSets_en.length);

const introHtml = timeRangeIntros_en[vi](start24, end24, hours);
const contextText = getContextClusterEN(range.start, range.end, hours);
const useCaseList = useCases_en[ui];
// Merged FAQ: time-range questions + net-after-break questions
const faqs = [
  ...faqSets_en[fi](start24, end24, hours),
  ...workHoursFaqSets_en[0](start24, end24, net30.netDecimal),
];

const similarRanges = getSimilarRanges(range, 8);

const seoMeta = buildSEOMeta(
  'time-range', lang,
  { start: start24, end: end24, hours: hours.toString() },
  canonical, 'de', altUrl,
  !shouldIndex('time-range', range.demandScore) || shouldNoindexByDemand(canonical),
);

const jsonLd = [
  buildFAQSchema(faqs),
  buildBreadcrumbSchema([
    { name: 'Home', url: getHubUrl(lang) },
    { name: `${hours} hours (${start24}–${end24})`, url: canonical },
  ]),
];

const useCaseIcons = ['', '', '', '', '', ''];
const lastUpdated = new Date().toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={seoMeta.title}
  description={seoMeta.description}
  canonical={seoMeta.canonical}
  hreflang={seoMeta.hreflang}
  noindex={seoMeta.noindex}
  lang={lang}
  jsonLd={jsonLd}
  ogImage={seoMeta.ogImage}
  ogImageAlt={seoMeta.ogImageAlt}
  theme="time-range"
  band={band}
  archetype={archetype}
  treatment={treatment}
>

  <!-- ─── HERO (answer first) ────────────────────────────────────────────── -->
  <section class="section landing-hero" style="padding-bottom: 1.5rem;">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={getHubUrl(lang)}>Home</a>
        <span class="breadcrumb__sep">›</span>
        <span aria-current="page">Hours between {start24} and {end24}</span>
      </nav>

      <div style="margin-top: 1.5rem; max-width: 760px;">
        <div class="landing-hero__meta" style="margin-bottom: 1rem;">
          {range.workShift && <span class="badge badge--green">Work Shift</span>}
          <span class="badge badge--accent">{gross.grossDecimalStr}h Result</span>
        </div>

        <h1 style="font-size: clamp(1.7rem, 3.4vw, 2.4rem); margin-bottom: 1.25rem; line-height: 1.2;">How Many Hours Between {start24} and {end24}?</h1>

        <div class="featured-snippet" role="complementary" aria-label="Quick Answer" style="margin: 0;">
          <div class="featured-snippet__label">Quick Answer</div>
          <div class="featured-snippet__answer"><span data-result="gross-hours">{gross.grossDecimalStr}</span> Hours</div>
          <p class="featured-snippet__sentence" style="margin-top: var(--space-2); margin-bottom: 0;">
            There are exactly <strong>{gross.grossDecimalStr} hours</strong> between {start24} and {end24} (<span data-result="gross-minutes">{gross.grossMin}</span> minutes / <span data-result="gross-seconds">{gross.grossMin * 60}</span> seconds).
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── RESULT VISUAL (treatment: band | dial | split) ─────────────────── -->
  <ShiftVisual treatment={treatment} start={range.start} end={range.end} breakMin={bandBreak} lang="en" />

  <!-- ─── RESULT TRIPTYCH ────────────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="result-triptych">
        <div class="result-card">
          <span class="result-card__label">Hrs:Min</span>
          <span class="result-card__value" data-result="gross-hours-hhmm">{gross.grossHHMM}</span>
          <button class="copy-btn" type="button" data-copy={gross.grossHHMM} aria-label="Copy hours:minutes">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>
        <div class="result-card">
          <span class="result-card__label">Decimal <span class="result-card__hint">for payroll</span></span>
          <span class="result-card__value" data-result="gross-decimal">{gross.grossDecimalStr}</span>
          <button class="copy-btn" type="button" data-copy={gross.grossDecimalStr} aria-label="Copy decimal hours">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>
        <div class="result-card">
          <span class="result-card__label">Minutes</span>
          <span class="result-card__value" data-result="gross-minutes">{gross.grossMin}</span>
          <button class="copy-btn" type="button" data-copy={String(gross.grossMin)} aria-label="Copy minutes">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CONDITIONAL MODULES (Phase 5.4 — only what applies) ────────────── -->
  <ShiftModules modules={shiftModules} lang="en" />

  <!-- ─── NET WORK TIME (merged work-hours content, Phase 3.3) ────────────── -->
  <section class="section" style="padding-top: 0;" id="work-hours">
    <div class="container container--narrow">
      <div class="payroll-sheet">
        <h2 style="margin-top: 0; margin-bottom: 8px; font-size: 1.3rem;">Net Work Hours from {start24} to {end24} (after break)</h2>
        <p style="margin-top: 0; margin-bottom: 20px; color: var(--clr-text-2); font-size: 0.95rem;">
          As a work shift, {start24}–{end24} gives <strong><span data-result="net-hhmm-30">{net30.netHHMM}</span></strong>
          net with a 30-minute break — that is <strong><span data-result="net-decimal-30">{net30.netDecimalStr}</span> decimal hours</strong> for payroll.
        </p>
        {breakResults.map(br => {
          const pct = br.result.grossMin > 0 ? (br.result.netMin / br.result.grossMin) * 100 : 0;
          return (
            <div class="payroll-row">
              <div class="payroll-info">
                <span class="payroll-label">{br.break === 0 ? 'No break' : `${br.break} min break`}</span>
                <span class="payroll-val">
                  <span data-result={`net-hhmm-${br.break}`}>{br.result.netHHMM}</span> (<span data-result={`net-decimal-${br.break}`}>{br.result.netDecimalStr}</span>h)
                </span>
              </div>
              <div class="payroll-bar-track">
                <div class="payroll-bar-fill" style={`width: ${pct}%`} />
              </div>
            </div>
          );
        })}
        <p style="margin-top: 16px; margin-bottom: 0; font-size: 0.85rem; color: var(--clr-text-3);">
          Rest breaks are unpaid: a shift over 6 hours typically requires a 20–30 minute break that is deducted from paid time.
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <div class="content-section">
        <h2>Calculating the Duration from {start24} to {end24}</h2>
        <div class="content-prose">
          <p set:html={introHtml} />

          <div class="expert-box" style="margin-top: 40px; padding: 24px; background: var(--clr-surf-2); border-radius: 12px; border: 1px solid var(--clr-border);">
            <h3 style="margin-top: 0;">Precision & Modern Timekeeping</h3>
            <p>
              In modern computing and logistics, determining time differences relies on the <strong>sexagesimal system</strong> (base 60). 
              Our calculator uses high-precision offsets to ensure that even complex scenarios—like overnight shifts crossing 
              the midnight threshold—are calculated with 100% accuracy.
            </p>
            <p style="margin-top: 15px; margin-bottom: 0; font-size: 0.9rem; color: var(--clr-text-3);">
              <em>Did you know? Precise timekeeping is a cornerstone of global GPS synchronization, network latency management, 
              and efficient international supply chain coordination.</em>
            </p>
          </div>
        </div>
      </div>

      <div class="content-section">
        <h2>Use Cases</h2>
        <div class="use-cases">
          {useCaseList.map((uc, i) => (
            <a href={`#faq-${i % faqs.length}`} class="use-case-item">
              <span class="use-case-item__icon">{useCaseIcons[i % useCaseIcons.length]}</span>
              <span class="use-case-item__text">{uc}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container container--narrow">
      <div class="embedded-calc">
        <div class="embedded-calc__header">
          <div class="embedded-calc__title">Try the Calculator</div>
          <div class="embedded-calc__subtitle">Adjust start and end times for your own calculation</div>
        </div>
        <WorkHoursCalc client:visible lang="en"
          defaultStart={formatHour24(range.start)}
          defaultEnd={formatHour24(range.end)}
          defaultBreak={0}
        />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;" id="faq-section">
    <div class="container container--narrow">
      <div class="content-section">
        <h2>Frequently Asked Questions</h2>
        <div class="faq-list" itemscope itemtype="https://schema.org/FAQPage">
          {faqs.map((faq, idx) => (
            <div class="faq-item" id={`faq-${idx}`} itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
              <button class="faq-item__question" aria-expanded="false" itemprop="name" aria-controls={`faq-answer-${idx}`}>
                {faq.q}
                <span class="faq-arrow" aria-hidden="true">▾</span>
              </button>
              <div class="faq-item__answer" id={`faq-answer-${idx}`} aria-hidden="true" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <span itemprop="text">{faq.a}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="internal-links">
        <div class="internal-links__header">
          <h2 class="internal-links__title" style="font-size: 1.2rem; margin: 0;">Similar Time Ranges</h2>
        </div>
        <div class="link-grid">
          {similarRanges.map(r => {
            const h = getRangeHours(r.start, r.end);
            return (
              <a href={getTimeRangeUrl(lang, r.slug)} class="link-card">
                <span>Hours between {formatHour24(r.start)} and {formatHour24(r.end)} ({h}h)</span>
                <span class="link-card__arrow">→</span>
              </a>
            );
          })}
          <a href={getHubUrl(lang)} class="link-card">
            <span>← Back to Time Calculator</span>
            <span class="link-card__arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
